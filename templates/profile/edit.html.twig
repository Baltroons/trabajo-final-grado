{% extends 'base.html.twig' %}

{% block title %}Sala: {{ sala.nombre }} — BrainHub{% endblock %}

{% block body %}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

        {# --- ENCABEZADO HERO --- #}
        <div class="bg-gradient-to-r from-emerald-900 to-teal-800 rounded-3xl shadow-xl p-8 md:p-10 mb-8 text-white relative overflow-hidden">
            <div class="absolute top-0 right-0 -mr-20 -mt-20 w-72 h-72 rounded-full bg-white opacity-10 blur-3xl"></div>

            <div class="relative z-10 flex flex-col md:flex-row md:items-start justify-between gap-6">
                <div>
                    <a href="{{ path('app_home') }}" class="text-emerald-200 hover:text-white text-sm font-semibold flex items-center gap-1 mb-4 transition-colors w-fit">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                        Volver a las salas
                    </a>
                    <div class="flex items-center gap-3 mb-2">
                    <span class="px-3 py-1 bg-emerald-700/50 border border-emerald-500/30 text-emerald-100 text-xs font-bold rounded-lg uppercase tracking-wider backdrop-blur-sm">
                        {{ sala.categoria }}
                    </span>
                    </div>
                    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4">{{ sala.nombre }}</h1>
                    <p class="text-emerald-100 text-lg max-w-2xl leading-relaxed">
                        {{ sala.descripcion ?: 'Espacio de estudio colaborativo. Únete para participar en la conversación y compartir apuntes.' }}
                    </p>
                </div>

                {% if app.user == sala.creador %}
                    <div class="flex flex-shrink-0 gap-3">
                        {# Botón de Ajustes ahora abre un modal en lugar de redirigir #}
                        <button onclick="openEditModal()" class="bg-white/10 hover:bg-white/20 border border-white/20 text-white px-5 py-2.5 rounded-xl font-semibold backdrop-blur-md transition-all flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                            Ajustes
                        </button>
                        <div class="bg-red-500/80 hover:bg-red-600 border border-red-400/50 rounded-xl overflow-hidden backdrop-blur-md transition-all">
                            {{ include('sala/_delete_form.html.twig') }}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        {# --- NAVEGACIÓN DE PESTAÑAS (TABS) --- #}
        <div class="flex space-x-1 bg-gray-200/50 p-1 rounded-2xl mb-8 w-full md:w-fit mx-auto md:mx-0">
            <button onclick="switchTab('foro')" id="btn-foro" class="tab-btn flex-1 md:flex-none px-6 py-2.5 rounded-xl text-sm font-bold bg-white text-emerald-700 shadow-sm transition-all">
                💬 Foro y Chat
            </button>
            <button onclick="switchTab('multimedia')" id="btn-multimedia" class="tab-btn flex-1 md:flex-none px-6 py-2.5 rounded-xl text-sm font-bold text-gray-500 hover:text-gray-700 hover:bg-gray-100 transition-all">
                📁 Multimedia
            </button>
            <button onclick="switchTab('info')" id="btn-info" class="tab-btn flex-1 md:flex-none px-6 py-2.5 rounded-xl text-sm font-bold text-gray-500 hover:text-gray-700 hover:bg-gray-100 transition-all">
                ℹ️ Información
            </button>
        </div>

        {# --- CONTENEDORES DE LAS VISTAS --- #}

        {# VISTA 1: FORO Y CHAT #}
        <div id="tab-foro" class="tab-content block animate-fade-in">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                <div class="lg:col-span-8 space-y-8">
                    <div class="bg-white rounded-3xl shadow-sm border border-gray-200 overflow-hidden flex flex-col h-[700px] relative">
                        <div class="p-5 border-b border-gray-100 bg-gray-50 flex items-center justify-between z-10">
                            <h3 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                                <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                                Foro General
                            </h3>
                            <span class="text-xs font-bold text-emerald-600 bg-emerald-100 px-3 py-1.5 rounded-full shadow-sm">{{ mensajes|length }} mensajes</span>
                        </div>

                        <div id="muro-mensajes" class="flex-1 overflow-y-auto p-6 space-y-6 bg-gray-50/30 pb-32">
                            {% for m in mensajes %}
                                {% set isMe = app.user and m.autor.id == app.user.id %}
                                <div class="flex gap-4 {{ isMe ? 'flex-row-reverse' : '' }}">
                                    <div class="w-10 h-10 rounded-full flex-shrink-0 flex items-center justify-center font-bold text-sm shadow-sm {{ isMe ? 'bg-gradient-to-br from-emerald-500 to-emerald-700 text-white' : 'bg-white border border-gray-200 text-gray-700' }}">
                                        {{ m.autor.username|first|upper }}
                                    </div>
                                    <div class="flex flex-col {{ isMe ? 'items-end' : 'items-start' }} max-w-[80%]">
                                        <div class="flex items-center gap-2 mb-1">
                                            <span class="text-xs font-bold text-gray-500">{{ isMe ? 'Tú' : m.autor.username }}</span>
                                            <span class="text-[10px] text-gray-400 font-medium">{{ m.fechaCreacion|date('H:i') }}</span>
                                        </div>
                                        <div class="p-4 rounded-2xl text-sm shadow-sm whitespace-pre-wrap {{ isMe ? 'bg-emerald-600 text-white rounded-tr-none' : 'bg-white border border-gray-100 text-gray-800 rounded-tl-none' }}">{{ m.contenido }}</div>

                                        {# Si el mensaje tiene un archivo adjunto, lo mostramos aquí #}
                                        {% if m.archivo %}
                                            <a href="{{ asset('uploads/archivos/' ~ m.archivo) }}" target="_blank" class="mt-2 flex items-center gap-2 bg-gray-100 hover:bg-gray-200 border border-gray-200 p-2.5 rounded-xl text-xs font-semibold text-gray-700 transition-colors {{ isMe ? 'self-end' : 'self-start' }}">
                                                <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
                                                Ver archivo adjunto
                                            </a>
                                        {% endif %}
                                    </div>
                                </div>
                            {% else %}
                                <div class="h-full flex flex-col items-center justify-center text-center opacity-60">
                                    <span class="text-6xl mb-4">💬</span>
                                    <p class="text-gray-800 font-bold text-lg">El foro está muy silencioso.</p>
                                    <p class="text-sm text-gray-500 mt-1">Anímate y sé el primero en saludar a la clase.</p>
                                </div>
                            {% endfor %}
                        </div>

                        {% if app.user in sala.miembros or app.user == sala.creador %}
                            {# Área de input mejorada (Flotante sobre el final del chat) #}
                            <div class="absolute bottom-0 w-full p-4 bg-gradient-to-t from-white via-white to-transparent pt-10">
                                <div class="bg-white rounded-3xl shadow-[0_5px_40px_-10px_rgba(0,0,0,0.1)] border border-gray-100 p-2 flex flex-col">

                                    <div id="file-preview-container" class="hidden mx-4 mt-2 mb-2 bg-emerald-50 text-emerald-700 text-xs font-bold rounded-xl border border-emerald-200 flex items-center justify-between w-max max-w-[200px] sm:max-w-xs px-3 py-2">
                                        <div class="flex items-center gap-2 truncate">
                                            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                                            <span id="file-name-preview" class="truncate">archivo.pdf</span>
                                        </div>
                                        <button type="button" onclick="clearFileAttachment()" class="ml-3 text-emerald-900 hover:text-red-500 transition-colors">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                        </button>
                                    </div>

                                    {{ form_start(formMensaje, {'attr': {'class': 'flex items-end gap-2', 'id': 'chat-form', 'enctype': 'multipart/form-data'}}) }}
                                    <button type="button" onclick="document.getElementById('archivo_adjunto').click()" class="relative flex-shrink-0 text-gray-400 hover:text-emerald-600 hover:bg-emerald-50 transition-all p-3 rounded-full mb-1" title="Adjuntar archivo">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
                                        <span id="file-indicator" class="hidden absolute top-2 right-2 w-3 h-3 bg-red-500 border-2 border-white rounded-full"></span>
                                    </button>
                                    <input type="file" name="archivo_adjunto" id="archivo_adjunto" class="hidden" onchange="handleFileSelect(this)">

                                    <div class="flex-1 mb-1">
                                        {{ form_widget(formMensaje.contenido, {'attr': {'class': 'w-full bg-transparent border-none focus:ring-0 px-2 py-3 text-sm text-gray-800 placeholder-gray-400 resize-none max-h-32', 'placeholder': 'Escribe un mensaje para la clase...', 'rows': '1', 'oninput': 'this.style.height = "";this.style.height = this.scrollHeight + "px"'}}) }}
                                    </div>
                                    <button type="submit" class="bg-gradient-to-br from-emerald-500 to-emerald-700 hover:from-emerald-600 hover:to-emerald-800 text-white w-12 h-12 rounded-full flex items-center justify-center transition-transform hover:scale-105 shadow-md flex-shrink-0 mb-1 mr-1">
                                        <svg class="w-5 h-5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
                                    </button>
                                    {{ form_end(formMensaje) }}
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# Panel Lateral: Miembros #}
                <div class="lg:col-span-4 space-y-6">
                    {% if app.user == sala.creador %}
                        <div class="bg-gradient-to-br from-gray-900 to-gray-800 rounded-3xl p-6 text-white shadow-lg">
                            <span class="bg-yellow-400 text-yellow-900 text-[10px] font-black px-2.5 py-1 rounded-md mb-3 inline-block uppercase tracking-wider">Admin</span>
                            <h4 class="text-xl font-bold mb-4">Tú mandas aquí</h4>
                            <button onclick="openInviteModal()" class="w-full bg-white text-gray-900 py-3 rounded-xl text-sm font-bold hover:bg-gray-100 transition-colors shadow-sm">+ Invitar Estudiantes</button>
                        </div>
                    {% endif %}

                    <div class="bg-white rounded-3xl shadow-sm border border-gray-200 p-6">
                        <h3 class="font-bold text-gray-900 mb-6 flex justify-between border-b pb-4">
                            <span>Estudiantes</span>
                            <span class="bg-emerald-100 text-emerald-700 px-2.5 py-1 rounded-lg text-xs font-bold">{{ sala.miembros|length + 1 }}</span>
                        </h3>
                        <div class="space-y-4 max-h-[400px] overflow-y-auto pr-2">
                            {# Creador #}
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 bg-amber-100 text-amber-700 rounded-xl flex items-center justify-center font-bold">{{ sala.creador.username|first|upper }}</div>
                                    <span class="text-sm font-bold text-gray-900">{{ sala.creador.username }}</span>
                                </div>
                                <span class="text-amber-500" title="Creador de la sala">★</span>
                            </div>
                            {# Miembros #}
                            {% for miembro in sala.miembros %}
                                <div class="flex items-center justify-between group">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 bg-gray-100 text-gray-600 rounded-full flex items-center justify-center text-xs font-bold">{{ miembro.username|first|upper }}</div>
                                        <span class="text-sm text-gray-700 font-medium">{{ miembro.username }}</span>
                                    </div>
                                    {% if app.user == sala.creador %}
                                        <form action="{{ path('app_sala_expulsar', {'id': sala.id, 'user_id': miembro.id}) }}" method="POST" onsubmit="return confirm('¿Estás seguro de expulsar a este estudiante?');">
                                            <button type="submit" class="text-gray-300 hover:text-red-500 p-1 transition-colors" title="Expulsar">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7a4 4 0 11-8 0 4 4 0 018 0zM9 14a6 6 0 00-6 6v1h12v-1a6 6 0 00-6-6zM21 12h-6"></path></svg>
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# VISTA 2: MULTIMEDIA #}
        <div id="tab-multimedia" class="tab-content hidden animate-fade-in">
            <div class="bg-white rounded-3xl shadow-sm border border-gray-200 p-8 min-h-[500px]">
                <div class="mb-8 border-b border-gray-100 pb-6">
                    <h3 class="text-2xl font-black text-gray-900">Biblioteca Multimedia</h3>
                    <p class="text-sm text-gray-500 mt-2">Todos los archivos compartidos en el chat aparecerán aquí automáticamente.</p>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-6">
                    {# Iteramos sobre los archivos asociados a la sala (si tienes la relación configurada así) #}
                    {% for archivo in sala.archivos %}
                        <a href="{{ asset('uploads/archivos/' ~ archivo.nombreArchivo) }}" target="_blank" class="group flex flex-col items-center bg-gray-50 rounded-2xl p-6 border border-gray-100 hover:border-emerald-300 hover:shadow-md transition-all">
                            <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                            </div>
                            <span class="text-xs font-bold text-gray-800 text-center truncate w-full" title="{{ archivo.nombreOriginal }}">{{ archivo.nombreOriginal }}</span>
                            <span class="text-[10px] text-gray-400 mt-1">{{ archivo.fechaSubida|date('d/m/Y') }}</span>
                        </a>
                    {% else %}
                        <div class="col-span-full py-20 flex flex-col items-center justify-center text-center">
                            <div class="w-20 h-20 bg-gray-50 rounded-full flex items-center justify-center mb-4">
                                <svg class="w-10 h-10 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 19a2 2 0 01-2-2V7a2 2 0 012-2h4l2 2h4a2 2 0 012 2v1M5 19h14a2 2 0 002-2v-5a2 2 0 00-2-2H9a2 2 0 00-2 2v5a2 2 0 01-2 2z"></path></svg>
                            </div>
                            <p class="text-gray-500 font-bold">No hay archivos en esta sala todavía.</p>
                            <p class="text-sm text-gray-400 mt-1">Adjunta documentos desde el chat para que aparezcan aquí.</p>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        {# VISTA 3: INFO #}
        <div id="tab-info" class="tab-content hidden animate-fade-in">
            <div class="bg-white rounded-3xl shadow-sm border border-gray-200 p-8 max-w-4xl mx-auto">
                <h3 class="text-2xl font-black text-gray-900 mb-6 border-b pb-4">Detalles de la Sala</h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-8">
                    <div class="space-y-6">
                        <div>
                            <span class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-1">Nombre</span>
                            <p class="text-lg font-bold text-gray-800">{{ sala.nombre }}</p>
                        </div>
                        <div>
                            <span class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-1">Categoría</span>
                            <span class="inline-block bg-emerald-100 text-emerald-800 font-bold px-3 py-1 rounded-lg text-sm">{{ sala.categoria }}</span>
                        </div>
                        <div>
                            <span class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-1">Descripción</span>
                            <p class="text-gray-600 leading-relaxed bg-gray-50 p-4 rounded-2xl">{{ sala.descripcion ?: 'Sin descripción establecida.' }}</p>
                        </div>
                    </div>
                    <div class="space-y-6 bg-gray-50 p-6 rounded-3xl border border-gray-100 h-fit">
                        <div>
                            <span class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-1">Creador</span>
                            <div class="flex items-center gap-3 mt-2">
                                <div class="w-8 h-8 bg-amber-100 text-amber-700 rounded-lg flex items-center justify-center font-bold">{{ sala.creador.username|first|upper }}</div>
                                <span class="font-bold text-gray-800">{{ sala.creador.username }}</span>
                            </div>
                        </div>
                        <div>
                            <span class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-1">Estadísticas</span>
                            <div class="flex gap-4 mt-2">
                                <div class="bg-white p-3 rounded-xl border border-gray-100 text-center flex-1">
                                    <span class="block text-2xl font-black text-emerald-600">{{ sala.miembros|length + 1 }}</span>
                                    <span class="text-[10px] uppercase font-bold text-gray-400">Estudiantes</span>
                                </div>
                                <div class="bg-white p-3 rounded-xl border border-gray-100 text-center flex-1">
                                    <span class="block text-2xl font-black text-emerald-600">{{ mensajes|length }}</span>
                                    <span class="text-[10px] uppercase font-bold text-gray-400">Mensajes</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    {# --- MODAL DE INVITACIÓN --- #}
    <div id="inviteModal" class="fixed inset-0 z-50 hidden bg-gray-900/60 backdrop-blur-sm flex items-center justify-center transition-opacity opacity-0">
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-md mx-4 overflow-hidden transform scale-95 transition-transform" id="inviteModalContent">
            <div class="px-6 py-5 border-b bg-gray-50 flex justify-between items-center">
                <h3 class="font-black text-gray-900 text-lg">Invitar Estudiante</h3>
                <button onclick="closeInviteModal()" class="text-gray-400 hover:text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-full w-8 h-8 flex items-center justify-center transition-colors">✖</button>
            </div>
            <div class="p-6">
                <form action="{{ path('app_sala_invitar', {'id': sala.id}) }}" method="POST" class="space-y-4">
                    <div>
                        <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-2">Email o Username</label>
                        <input type="text" name="usuario_invitado" required class="w-full p-4 rounded-2xl bg-gray-50 border border-gray-100 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 transition-all outline-none font-medium" placeholder="ejemplo@correo.com">
                    </div>
                    <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-black py-4 rounded-2xl shadow-xl shadow-emerald-100 transition-all transform hover:-translate-y-1 active:scale-95 uppercase tracking-widest text-sm">Enviar Invitación</button>
                </form>
                <div class="mt-6">
                    <span class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-2">O comparte este enlace</span>
                    <div class="flex bg-gray-50 border border-gray-200 rounded-2xl p-1.5 items-center">
                        <input type="text" readonly value="{{ url('app_sala_join', {'id': sala.id}) }}" class="bg-transparent text-sm text-gray-600 font-medium w-full px-3 outline-none" id="inviteLink">
                        <button onclick="copyInviteLink()" class="bg-white text-emerald-600 font-bold text-sm px-4 py-2.5 rounded-xl border border-gray-200 shadow-sm hover:bg-gray-50 transition-colors">Copiar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# --- MODAL DE EDICIÓN DE SALA (Con el estilo del perfil) --- #}
    <div id="editModal" class="fixed inset-0 z-50 hidden bg-gray-900/60 backdrop-blur-sm flex items-center justify-center transition-opacity opacity-0 overflow-y-auto">
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-2xl mx-4 my-8 overflow-hidden transform scale-95 transition-transform" id="editModalContent">
            <div class="px-8 py-6 border-b border-gray-100 bg-gray-50 flex justify-between items-center sticky top-0 z-10">
                <div>
                    <h3 class="text-2xl font-black text-gray-900 tracking-tight">Configuración de la Sala</h3>
                    <p class="text-gray-500 text-xs mt-1 font-medium">Modifica los detalles de este espacio de estudio.</p>
                </div>
                <button onclick="closeEditModal()" class="text-gray-400 hover:text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-full w-8 h-8 flex items-center justify-center transition-colors">✖</button>
            </div>

            <div class="p-8">
                {# Formulario hacia tu controlador de edición de sala #}
                <form action="{{ path('app_sala_edit', {'id': sala.id}) }}" method="POST" class="space-y-6">

                    {# Campo Nombre #}
                    <div>
                        <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-2">Nombre de la Sala</label>
                        <input type="text" name="nombre" value="{{ sala.nombre }}" required
                               class="w-full p-4 rounded-2xl bg-gray-50 border border-gray-100 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 transition-all outline-none font-medium text-gray-800">
                    </div>

                    {# Campo Categoría #}
                    <div>
                        <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-2">Categoría</label>
                        <input type="text" name="categoria" value="{{ sala.categoria }}" placeholder="Ej: Matemáticas, Programación..." required
                               class="w-full p-4 rounded-2xl bg-gray-50 border border-gray-100 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 transition-all outline-none font-medium text-gray-800">
                    </div>

                    {# Campo Descripción #}
                    <div>
                        <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-2">Descripción</label>
                        <textarea name="descripcion" rows="3" placeholder="¿De qué trata esta sala?"
                                  class="w-full p-4 rounded-2xl bg-gray-50 border border-gray-100 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 transition-all outline-none font-medium text-gray-800 resize-none">{{ sala.descripcion }}</textarea>
                    </div>

                    {# Tarjeta Info Extra #}
                    <div class="bg-emerald-50 p-5 rounded-2xl border border-emerald-100 flex items-start gap-4">
                        <div class="bg-emerald-200 p-1.5 rounded-lg text-emerald-700 mt-0.5">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path></svg>
                        </div>
                        <p class="text-xs text-emerald-800 leading-relaxed font-medium">
                            Solo tú como administrador puedes modificar estos datos. Los cambios se aplicarán inmediatamente para todos los estudiantes.
                        </p>
                    </div>

                    {# Botones #}
                    <div class="pt-4 flex gap-4">
                        <button type="button" onclick="closeEditModal()" class="w-full bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 font-black py-4 rounded-2xl transition-all uppercase tracking-widest text-sm">
                            Cancelar
                        </button>
                        <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-black py-4 rounded-2xl shadow-xl shadow-emerald-100 transition-all transform hover:-translate-y-1 active:scale-95 uppercase tracking-widest text-sm">
                            Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // --- 1. SCRIPT DE PESTAÑAS (TABS) ---
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => {
                el.classList.remove('block');
                el.classList.add('hidden');
            });

            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('bg-white', 'text-emerald-700', 'shadow-sm');
                btn.classList.add('text-gray-500', 'hover:bg-gray-100');
            });

            const selectedTab = document.getElementById('tab-' + tabId);
            if (selectedTab) {
                selectedTab.classList.remove('hidden');
                selectedTab.classList.add('block');
            }

            const activeBtn = document.getElementById('btn-' + tabId);
            if (activeBtn) {
                activeBtn.classList.remove('text-gray-500', 'hover:bg-gray-100');
                activeBtn.classList.add('bg-white', 'text-emerald-700', 'shadow-sm');
            }

            // Si volvemos al foro, hacemos scroll hacia abajo por si hay mensajes nuevos
            if(tabId === 'foro') {
                scrollToBottom();
            }
        }

        // --- 2. DRAG & DROP DE ARCHIVOS EN EL CHAT ---
        document.addEventListener('DOMContentLoaded', () => {
            const dropZone = document.getElementById('muro-mensajes');
            const fileInput = document.getElementById('archivo_adjunto');

            if (dropZone && fileInput) {
                ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                    dropZone.addEventListener(eventName, preventDefaults, false);
                });

                function preventDefaults(e) {
                    e.preventDefault();
                    e.stopPropagation();
                }

                ['dragenter', 'dragover'].forEach(eventName => {
                    dropZone.addEventListener(eventName, () => {
                        dropZone.classList.add('border-2', 'border-emerald-500', 'border-dashed', 'bg-emerald-50/50');
                    }, false);
                });

                ['dragleave', 'drop'].forEach(eventName => {
                    dropZone.addEventListener(eventName, () => {
                        dropZone.classList.remove('border-2', 'border-emerald-500', 'border-dashed', 'bg-emerald-50/50');
                    }, false);
                });

                dropZone.addEventListener('drop', (e) => {
                    const dt = e.dataTransfer;
                    const files = dt.files;

                    if (files.length > 0) {
                        fileInput.files = files;
                        if (typeof handleFileSelect === 'function') {
                            handleFileSelect(fileInput);
                        }
                    }
                }, false);
            }
        });

        // --- 3. SCRIPT DE ARCHIVOS EN CHAT ---
        function handleFileSelect(input) {
            const indicator = document.getElementById('file-indicator');
            const previewContainer = document.getElementById('file-preview-container');
            const previewText = document.getElementById('file-name-preview');

            if (input.files && input.files.length > 0) {
                indicator.classList.remove('hidden');
                previewText.textContent = input.files[0].name;
                previewContainer.classList.remove('hidden');
                // Auto-enfocar el textarea para escribir rápido el mensaje
                document.querySelector('textarea[name="mensaje[contenido]"]').focus();
            } else {
                clearFileAttachment();
            }
        }

        function clearFileAttachment() {
            const input = document.getElementById('archivo_adjunto');
            if (input) input.value = '';

            const indicator = document.getElementById('file-indicator');
            const previewContainer = document.getElementById('file-preview-container');

            if (indicator) indicator.classList.add('hidden');
            if (previewContainer) previewContainer.classList.add('hidden');
        }

        // --- 4. MODAL DE INVITACIONES ---
        const modalInvite = document.getElementById('inviteModal');
        const modalInviteContent = document.getElementById('inviteModalContent');

        function openInviteModal() {
            modalInvite.classList.remove('hidden');
            setTimeout(() => {
                modalInvite.classList.remove('opacity-0');
                modalInviteContent.classList.remove('scale-95');
            }, 10);
        }

        function closeInviteModal() {
            modalInvite.classList.add('opacity-0');
            modalInviteContent.classList.add('scale-95');
            setTimeout(() => {
                modalInvite.classList.add('hidden');
            }, 300);
        }

        function copyInviteLink() {
            const copyText = document.getElementById("inviteLink");
            copyText.select();
            copyText.setSelectionRange(0, 99999);
            navigator.clipboard.writeText(copyText.value);

            if (typeof Swal !== 'undefined') {
                Swal.fire({toast: true, position: 'top-end', icon: 'success', title: 'Enlace copiado', showConfirmButton: false, timer: 2000});
            } else {
                alert("Enlace copiado al portapapeles");
            }
        }

        // --- 5. MODAL DE EDICIÓN DE SALA ---
        const modalEdit = document.getElementById('editModal');
        const modalEditContent = document.getElementById('editModalContent');

        function openEditModal() {
            modalEdit.classList.remove('hidden');
            setTimeout(() => {
                modalEdit.classList.remove('opacity-0');
                modalEditContent.classList.remove('scale-95');
            }, 10);
        }

        function closeEditModal() {
            modalEdit.classList.add('opacity-0');
            modalEditContent.classList.add('scale-95');
            setTimeout(() => {
                modalEdit.classList.add('hidden');
            }, 300);
        }

        // --- 6. AUTO-SCROLL AL CARGAR ---
        function scrollToBottom() {
            const muro = document.getElementById('muro-mensajes');
            if (muro) {
                muro.scrollTop = muro.scrollHeight;
            }
        }

        document.addEventListener('DOMContentLoaded', scrollToBottom);

        // --- 7. AUTO-RESIZE DEL TEXTAREA DEL CHAT ---
        // (El evento oninput ya está en el HTML, pero aseguramos un tamaño base al cargar)
        document.addEventListener('DOMContentLoaded', () => {
            const textarea = document.querySelector('textarea[name="mensaje[contenido]"]');
            if(textarea) {
                textarea.style.height = 'auto';
            }
        });
    </script>
{% endblock %}
