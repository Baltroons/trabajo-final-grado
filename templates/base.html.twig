    <!DOCTYPE html>
    <html lang="es" class="light">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}">
        <title>{% block title %}BrainHub - Estudio Colaborativo{% endblock %}</title>

        <script src="https://cdn.tailwindcss.com"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        <script>
            // Configuración de Tailwind para soportar modo oscuro por clase
            tailwind.config = {
                darkMode: 'class',
                theme: {
                    extend: {
                        colors: {
                            darkBg: '#0f172a',
                            darkCard: '#1e293b',
                            darkBorder: '#334155'
                        }
                    }
                }
            }
        </script>

        {% block stylesheets %}{% endblock %}

        <style>
            @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
            .animate-fade-in { animation: fadeIn 0.3s ease-out forwards; }
            .dropdown-menu.hidden { display: none; }

            /* Transición suave para el modo oscuro */
            body * { transition: background-color 0.3s ease, border-color 0.3s ease; }

            #chat-messages-container::-webkit-scrollbar { width: 6px; }
            #chat-messages-container::-webkit-scrollbar-track { background: transparent; }
            #chat-messages-container::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }

            .typing-dot { animation: typing 1.4s infinite ease-in-out; fill: #9ca3af; }
            .typing-dot:nth-child(1) { animation-delay: 0s; }
            .typing-dot:nth-child(2) { animation-delay: 0.2s; }
            .typing-dot:nth-child(3) { animation-delay: 0.4s; }
            @keyframes typing { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }
        </style>
    </head>

    <body class="bg-[#f3f4f6] dark:bg-darkBg font-sans antialiased text-gray-900 dark:text-gray-100 flex flex-col {% if app.user %}h-screen overflow-hidden{% else %}min-h-screen{% endif %}">

    {# --- AUDIO PARA NOTIFICACIONES --- #}
    <audio id="notification-sound" src="{{ asset('sounds/notificacion_pop.mp3') }}" preload="auto"></audio>

    {# --- NAVBAR --- #}
    {# --- NAVBAR --- #}

    <nav class="bg-emerald-800 dark:bg-emerald-950 shadow-md z-50 shrink-0 relative border-b border-transparent dark:border-emerald-900">

        <div class="w-full px-6 md:px-10">

            <div class="flex justify-between h-16 items-center">



                {# LOGO #}

                <a href="{{ path('app_home') }}" class="flex items-center gap-2 text-white font-bold text-xl hover:text-emerald-200 transition-colors">

                    <img src="{{ asset('images/logo.png') }}" alt="BrainHub Logo" class="w-8 h-8 object-contain">

                    <span>BrainHub</span>

                </a>



                {# ACCIONES DERECHA #}

                <div class="flex items-center space-x-2 md:space-x-4 h-full">



                    {# BOTÓN TOGGLE MODO OSCURO/CLARO #}

                    <button onclick="toggleTheme()" class="p-2 rounded-xl bg-emerald-700/50 dark:bg-emerald-900/80 text-emerald-100 hover:text-white transition-all outline-none flex items-center justify-center">

                        <svg id="theme-sun" class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">

                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 9h-1m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"></path>

                        </svg>

                        <svg id="theme-moon" class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">

                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>

                        </svg>

                    </button>



                    {% if app.user %}

                        {# CAMPANA DE NOTIFICACIONES #}

                        <div class="relative flex items-center h-full">

                            <button id="notifMenuBtn" class="relative p-2 rounded-xl text-emerald-100 hover:text-white hover:bg-emerald-700/30 transition-all outline-none flex items-center justify-center">

                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">

                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>

                                </svg>

                                <span id="global-notif-badge" class="hidden absolute top-2 right-2.5 h-2.5 w-2.5 bg-red-500 rounded-full border-2 border-emerald-800"></span>

                            </button>



                            {# DROPDOWN NOTIFICACIONES - Corregido con top-full #}

                            <div id="notifDropdown" class="dropdown-menu hidden absolute right-0 top-full mt-2 w-72 bg-white dark:bg-darkCard rounded-2xl shadow-2xl border border-gray-100 dark:border-darkBorder py-2 z-[100] animate-fade-in">

                                <div class="px-4 py-2 border-b border-gray-50 dark:border-darkBorder">

                                    <span class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase">Notificaciones</span>

                                </div>

                                <div id="notif-list" class="max-h-64 overflow-y-auto">

                                    <p class="text-xs text-gray-400 text-center py-4">No tienes notificaciones nuevas.</p>

                                </div>

                            </div>

                        </div>



                        {# PERFIL DE USUARIO #}

                        <div class="relative flex items-center h-full">

                            <button id="userMenuBtn" class="flex items-center outline-none hover:opacity-80 transition-opacity">

                                <div class="h-10 w-10 bg-emerald-500 rounded-full flex items-center justify-center text-white font-black border-2 border-emerald-300 dark:border-emerald-700 shadow-sm uppercase text-sm overflow-hidden">

                                    {% if app.user.fotoPerfil %}

                                        <img src="{{ asset('uploads/profiles/' ~ app.user.fotoPerfil) }}" class="w-full h-full object-cover" alt="Perfil">

                                    {% else %}

                                        {{ app.user.username|first }}

                                    {% endif %}

                                </div>

                            </button>



                            {# DROPDOWN USUARIO - Corregido con top-full #}

                            <div id="userDropdown" class="dropdown-menu hidden absolute right-0 top-full mt-2 w-48 bg-white dark:bg-darkCard rounded-2xl shadow-2xl border border-gray-100 dark:border-darkBorder py-2 z-[100] animate-fade-in">

                                <div class="px-4 py-2 border-b border-gray-50 dark:border-darkBorder mb-1">

                                    <p class="text-sm font-bold text-gray-800 dark:text-white">{{ app.user.username }}</p>

                                </div>

                                <a href="{{ path('app_profile_edit') }}" class="flex items-center gap-3 px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-emerald-50 dark:hover:bg-emerald-900/30 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Mi Perfil</a>

                                <a href="{{ path('app_logout') }}" class="flex items-center gap-3 px-4 py-2 text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors">Cerrar Sesión</a>

                            </div>

                        </div>

                    {% endif %}

                </div>
            </div>
        </div>
    </nav>

    <div class="flex flex-grow w-full relative {% if app.user %}overflow-hidden{% endif %}">
        <main class="flex-grow w-full relative flex flex-col transition-all duration-500 ease-in-out {% if app.user %}overflow-y-auto{% endif %}">
            <div class="flex-grow">

                {% block body %}{% endblock %}
            </div>
        </main>

        {% if app.user %}
            {# --- SIDEBAR DE CHAT (Solo Logueados) --- #}
            <div id="chat-mobile-overlay" class="hidden fixed inset-0 bg-gray-900/50 backdrop-blur-sm z-30 lg:hidden"></div>

            <aside id="chatSidebar" class="absolute right-0 lg:relative h-full w-0 flex flex-col transition-all duration-500 ease-in-out z-40 shrink-0 bg-white dark:bg-darkCard shadow-2xl border-l border-gray-200 dark:border-darkBorder">
                <button id="toggleChatBtn" class="absolute left-0 top-1/2 -translate-y-1/2 transform -translate-x-full bg-emerald-600 dark:bg-emerald-700 text-white p-3 rounded-l-2xl shadow-lg hover:bg-emerald-700 transition-all z-50 flex flex-col items-center gap-2 border-y border-l border-emerald-500 dark:border-emerald-600">
                    <svg id="chatIcon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
                    <svg id="arrowIcon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"></path></svg>
                </button>

                <div class="h-full w-full flex flex-col overflow-hidden">
                    <div class="flex border-b border-gray-200 dark:border-darkBorder shrink-0 bg-white dark:bg-darkCard">
                        <button onclick="switchTab('salas')" id="tab-salas" class="flex-1 py-4 text-xs font-black uppercase tracking-widest border-b-2 border-emerald-500 text-emerald-600 dark:text-emerald-400">Salas</button>
                        <button onclick="switchTab('users')" id="tab-users" class="flex-1 py-4 text-xs font-black uppercase tracking-widest border-b-2 border-transparent text-gray-400 dark:text-gray-500 hover:text-emerald-500 dark:hover:text-emerald-400">Privados</button>
                    </div>

                    <div id="sidebar-list-container" class="flex-grow overflow-y-auto p-2 bg-gray-50/30 dark:bg-darkBg">
                        <div id="list-salas" class="space-y-1">
                            {% for s in app.user.salasSuscritas|merge(app.user.salasCreadas) %}
                                <div id="sidebar-sala-{{ s.id }}" onclick="window.switchChat('sala', {{ s.id }}, '{{ s.nombre|e('js') }}')"
                                     class="p-3 hover:bg-white dark:hover:bg-darkCard rounded-xl cursor-pointer transition-all flex items-center gap-3 border border-transparent hover:border-gray-100 dark:hover:border-darkBorder group">
                                    <div class="w-10 h-10 bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 rounded-full flex items-center justify-center font-bold shadow-sm">#</div>
                                    <span class="text-sm font-bold text-gray-700 dark:text-gray-200 flex-grow">{{ s.nombre }}</span>
                                    <span class="unread-badge hidden w-3 h-3 bg-red-500 rounded-full shadow-sm group-hover:scale-110 transition-transform"></span>
                                </div>
                            {% endfor %}
                        </div>
                        <div id="list-users" class="hidden space-y-1">
                            {# Usuarios se cargan aquí #}
                        </div>
                    </div>

                    <div id="active-chat-window" class="hidden absolute inset-0 bg-white dark:bg-darkCard flex flex-col z-20">
                        <div class="p-4 border-b border-gray-200 dark:border-darkBorder flex items-center gap-3 bg-white dark:bg-darkCard shadow-sm z-10 shrink-0">
                            <button onclick="closeChat()" class="p-2 bg-gray-50 dark:bg-darkBg hover:bg-gray-100 dark:hover:bg-gray-800 rounded-full text-gray-500 dark:text-gray-400 transition-colors"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg></button>
                            <div>
                                <h3 id="active-chat-title" class="font-black text-gray-800 dark:text-white text-base leading-tight"></h3>
                                <span id="active-chat-subtitle" class="text-[10px] text-emerald-500 dark:text-emerald-400 font-bold uppercase tracking-wide"></span>
                            </div>
                        </div>

                        <div id="chat-messages-container" class="flex-grow overflow-y-auto p-4 space-y-4 bg-[#f0f2f5] dark:bg-[#0b1120]"></div>

                        <div id="typing-indicator" class="hidden px-4 py-1 bg-[#f0f2f5] dark:bg-[#0b1120] text-xs text-gray-500 dark:text-gray-400 italic flex items-center gap-2">
                            <span id="typing-user">Alguien</span> está escribiendo
                            <svg width="16" height="16" viewBox="0 0 24 24"><circle class="typing-dot" cx="4" cy="12" r="3"/><circle class="typing-dot" cx="12" cy="12" r="3"/><circle class="typing-dot" cx="20" cy="12" r="3"/></svg>
                        </div>

                        <div class="p-4 border-t border-gray-200 dark:border-darkBorder bg-white dark:bg-darkCard shrink-0">
                            <div class="relative flex items-center gap-2">
                                <button onclick="document.getElementById('chat-file-input').click()" class="p-2 text-gray-400 dark:text-gray-500 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors bg-gray-50 dark:bg-darkBg rounded-full">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
                                </button>
                                <input type="file" id="chat-file-input" class="hidden" onchange="updateFilePreview(this)">

                                <div class="relative flex-grow">
                                    <input type="text" id="global-chat-input" placeholder="Escribe un mensaje..." class="w-full pl-4 pr-12 py-3 rounded-2xl bg-gray-100 dark:bg-darkBg border-transparent focus:bg-white dark:focus:bg-darkCard focus:border-emerald-500 dark:focus:border-emerald-600 focus:ring-2 focus:ring-emerald-200 dark:focus:ring-emerald-900/50 text-sm outline-none transition-all dark:text-white">
                                    <button id="send-chat-btn" class="absolute right-1 top-1 bottom-1 p-2 bg-emerald-600 text-white rounded-xl hover:bg-emerald-700 transition-colors shadow-sm"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"/></svg></button>
                                </div>
                            </div>
                            <div id="file-preview" class="hidden mt-2 text-xs text-emerald-600 dark:text-emerald-400 font-bold bg-emerald-50 dark:bg-emerald-900/30 px-3 py-1 rounded-lg w-max flex items-center gap-2">
                                <span id="file-preview-name"></span>
                                <button onclick="clearFile()" class="text-red-500 hover:text-red-700 dark:hover:text-red-400">✖</button>
                            </div>
                        </div>
                    </div>
                </div>
            </aside>
        {% endif %}
    </div>

    <footer class="bg-emerald-900 dark:bg-[#064e3b] border-t border-emerald-800 dark:border-emerald-950 py-2 px-6 shrink-0 z-50">
        <div class="flex justify-between items-center text-[10px] font-medium tracking-wider uppercase">
            <div class="text-emerald-400/60 dark:text-emerald-500/60">
                &copy; {{ "now"|date("Y") }} <span class="text-emerald-400 dark:text-emerald-500 font-bold">BrainHub</span> - Sistema de Estudio Colaborativo
            </div>
            <div class="flex gap-4 text-emerald-400/40 dark:text-emerald-500/40">
                <span>Versión 2.0</span>
                <span class="flex items-center gap-1">
                    <span class="h-1.5 w-1.5 bg-emerald-500 dark:bg-emerald-400 rounded-full animate-pulse"></span>
                    Servidor en línea
                </span>
            </div>
        </div>
    </footer>

    {# ======================================================= #}
    {# MODALES SPA PARA INICIAR SESIÓN Y REGISTRO              #}
    {# ======================================================= #}

    {# MODAL: INICIAR SESIÓN #}
    <div id="login-modal" class="hidden fixed inset-0 z-[300] flex items-center justify-center p-4 bg-gray-900/80 backdrop-blur-sm transition-opacity">
        <div class="bg-[#1e2330] w-full max-w-md rounded-[40px] shadow-2xl overflow-hidden animate-fade-in relative border border-gray-700">
            <button onclick="closeModal('login-modal')" class="absolute top-6 right-6 p-2 text-gray-400 hover:text-white transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
            <div class="p-10">
                <div class="text-center mb-8">
                    <h2 class="text-3xl font-black text-white">Bienvenido</h2>
                    <p class="text-gray-400 text-sm">Identifícate para entrar en tus salas</p>
                </div>

                <div id="login-error-msg" class="hidden mb-6 p-4 bg-red-900/40 text-red-200 text-xs rounded-2xl border border-red-800/50 flex items-center gap-3 italic">
                    <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"/></svg>
                    <span></span>
                </div>

                <form id="login-form" action="{{ path('app_login') }}" method="post" class="space-y-4">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <input type="text" name="_username" class="w-full px-6 py-4 bg-[#2a303f] border border-gray-700 rounded-2xl text-white focus:ring-2 focus:ring-emerald-500 outline-none text-sm transition-all" placeholder="Usuario" required>
                    <input type="password" name="_password" class="w-full px-6 py-4 bg-[#2a303f] border border-gray-700 rounded-2xl text-white focus:ring-2 focus:ring-emerald-500 outline-none text-sm transition-all" placeholder="Contraseña" required>
                    <button type="submit" class="w-full bg-emerald-800 hover:bg-emerald-700 text-white font-bold py-4 rounded-2xl transition-all shadow-lg shadow-emerald-900/20">Entrar ahora</button>
                </form>
                <div class="text-center mt-6">
                    <p class="text-sm text-gray-400">¿Nuevo aquí? <button onclick="switchModal('login-modal', 'register-modal')" class="text-emerald-400 font-bold hover:underline">Regístrate</button></p>
                </div>
            </div>
        </div>
    </div>

    {# MODAL: REGISTRO #}
    <div id="register-modal" class="hidden fixed inset-0 z-[300] flex items-center justify-center p-4 bg-gray-900/80 backdrop-blur-sm transition-opacity">
        <div class="bg-[#1e2330] w-full max-w-md rounded-[40px] shadow-2xl overflow-hidden animate-fade-in relative border border-gray-700">
            <button onclick="closeModal('register-modal')" class="absolute top-6 right-6 p-2 text-gray-400 hover:text-white transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
            <div class="p-10">
                <div class="text-center mb-6">
                    <h2 class="text-3xl font-black text-white">Crear cuenta</h2>
                    <p class="text-gray-400 text-sm">Únete a la comunidad de estudio</p>
                </div>

                <div id="reg-error-msg" class="hidden mb-6 p-4 bg-red-900/40 text-red-200 text-xs rounded-2xl border border-red-800/50 flex items-center gap-3 italic">
                    <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"/></svg>
                    <span></span>
                </div>

                <form id="register-form" action="{{ path('app_register') }}" method="post" class="space-y-4" novalidate>
                    <input type="hidden" name="registration_form[_token]" value="{{ csrf_token('registration_form') }}">
                    <input type="hidden" name="registration_form[agreeTerms]" value="1">
                    <div class="relative">
                        <input type="text" id="reg-username" name="registration_form[username]" class="w-full px-5 py-3.5 bg-[#2a303f] border border-gray-700 rounded-2xl text-white focus:ring-2 focus:ring-emerald-500 outline-none text-sm transition-all pr-10" placeholder="Nombre de usuario" required>
                        <div id="user-check-spinner" class="hidden absolute right-4 top-4">
                            <div class="w-4 h-4 border-2 border-emerald-500 border-t-transparent rounded-full animate-spin"></div>
                        </div>
                    </div>

                    <div class="relative">
                        <input type="email" id="reg-email" name="registration_form[email]" class="w-full px-5 py-3.5 bg-[#2a303f] border border-gray-700 rounded-2xl text-white focus:ring-2 focus:ring-emerald-500 outline-none text-sm transition-all pr-10" placeholder="Email" required>
                        <div id="email-check-spinner" class="hidden absolute right-4 top-4">
                            <div class="w-4 h-4 border-2 border-emerald-500 border-t-transparent rounded-full animate-spin"></div>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <input type="password" id="reg-password" name="registration_form[plainPassword]" class="w-full px-5 py-3.5 bg-[#2a303f] border border-gray-700 rounded-2xl text-white focus:ring-2 focus:ring-emerald-500 outline-none text-sm transition-all" placeholder="Contraseña" required>
                        <input type="password" id="reg-confirm-password" class="w-full px-5 py-3.5 bg-[#2a303f] border border-gray-700 rounded-2xl text-white focus:ring-2 focus:ring-emerald-500 outline-none text-sm transition-all" placeholder="Confirmar" required>
                    </div>

                    <div class="flex items-center gap-2 text-[10px] text-gray-400">
                        <input type="checkbox" name="registration_form[agreeTerms]" required class="rounded border-gray-600 bg-gray-700 text-emerald-600 focus:ring-offset-gray-900">
                        <span>Acepto los términos de uso</span>
                    </div>

                    <button type="submit" id="reg-submit-btn" class="w-full bg-emerald-800 hover:bg-emerald-700 text-white font-bold py-4 rounded-2xl transition-all shadow-lg transform hover:scale-[1.01]">Registrarme</button>
                </form>

                <div class="text-center mt-6">
                    <p class="text-xs text-gray-400">¿Ya tienes cuenta? <button onclick="switchModal('register-modal', 'login-modal')" class="text-emerald-400 font-bold hover:underline">Inicia sesión</button></p>
                </div>
            </div>
        </div>
    </div>

    {# MODAL DE VISTA PREVIA (CARRUSEL DE ARCHIVOS) #}
    <div id="preview-modal" class="hidden fixed inset-0 z-[400] flex items-center justify-center p-4 bg-gray-900/95 backdrop-blur-md animate-fade-in">

        {# Título de la sala (NUEVO) #}
        <div class="absolute top-6 left-6 md:left-10 text-white z-50 pointer-events-none">
            <h2 id="preview-room-title" class="text-xl md:text-2xl font-black tracking-tight text-emerald-400">Archivos de la Sala</h2>
            <p class="text-xs text-gray-400 uppercase tracking-widest">Visor multimedia</p>
        </div>

        {# Botón de cerrar #}
        <button onclick="closePreview()" class="absolute top-6 right-6 text-white hover:text-emerald-400 transition-colors z-50">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>

        {# Botón Anterior #}
        <button id="carousel-prev" onclick="navigateCarousel(-1)" class="absolute left-4 md:left-10 text-white hover:text-emerald-400 transition-colors z-50 hidden">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </button>

        {# Contenedor Principal #}
        <div class="w-full max-w-6xl max-h-[90vh] flex flex-col md:flex-row gap-6 items-center justify-center relative pointer-events-none">

            {# Zona de visualización del archivo (le quitamos el pointer-events-none para que se pueda clickear dentro) #}
            <div id="preview-content" class="flex-grow flex items-center justify-center w-full md:w-3/4 max-h-[70vh] md:max-h-[85vh] pointer-events-auto">
            </div>

            {# Panel de detalles y descarga (NUEVO DISEÑO) #}
            <div id="preview-details" class="w-full md:w-1/4 bg-gray-800 rounded-2xl p-6 text-white flex flex-col gap-4 shadow-2xl border border-gray-700 hidden pointer-events-auto">
                <div>
                    <h3 id="preview-filename" class="font-bold text-lg text-emerald-400 break-words leading-tight mb-1">NombreArchivo.jpg</h3>
                    <p id="preview-author" class="text-sm text-gray-300">Subido por <b>Usuario</b></p>
                </div>

                <div class="bg-gray-900/50 rounded-xl p-4 space-y-2 text-xs text-gray-400">
                    <div class="flex justify-between border-b border-gray-700/50 pb-2">
                        <span>Fecha:</span>
                        <span id="preview-date" class="font-mono text-gray-200">12/05/2024</span>
                    </div>
                    <div class="flex justify-between pt-1">
                        <span>Tamaño:</span>
                        <span id="preview-size" class="font-mono text-gray-200">Desconocido</span>
                    </div>
                </div>

                <div class="flex-grow"></div> <a id="preview-download-link" href="#" download class="w-full bg-emerald-600 hover:bg-emerald-500 text-center font-bold py-3 px-4 rounded-xl transition-colors shadow-lg flex items-center justify-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                    Descargar
                </a>
            </div>
        </div>

        {# Botón Siguiente #}
        <button id="carousel-next" onclick="navigateCarousel(1)" class="absolute right-4 md:right-10 text-white hover:text-emerald-400 transition-colors z-50 hidden">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </button>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // --- ESTADO DEL Carrusel ---
            let currentChatFiles = [];
            let currentCarouselIndex = 0;

            // --- NUEVA FUNCIÓN: Detectar YouTube ---
            function extractYouTubeId(text) {
                if (!text) return null;
                const regex = /(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/i;
                const match = text.match(regex);
                return match ? match[1] : null;
            }

            window.registerFileInCarousel = function(url, type, name, author, date, size, videoId = null) {
                const existingIndex = currentChatFiles.findIndex(f => f.url === url);
                if (existingIndex !== -1) return existingIndex;

                currentChatFiles.push({
                    url: url,
                    type: type,
                    name: name || 'Archivo adjunto',
                    uploadedBy: author || 'Desconocido',
                    date: date || 'Fecha desconocida',
                    size: size || 'Tamaño desconocido',
                    videoId: videoId // Guardamos el ID para el iframe
                });
                return currentChatFiles.length - 1;
            }

            window.openPreview = function(url, type, name, author, date, size) {
                const existingIndex = currentChatFiles.findIndex(f => f.url === url);
                if (existingIndex !== -1) {
                    window.openCarousel(existingIndex);
                } else {
                    currentChatFiles.push({
                        url: url,
                        type: type,
                        name: name || 'Archivo adjunto',
                        uploadedBy: author || 'Sistema',
                        date: date || 'Fecha desconocida',
                        size: size || null
                    });
                    window.openCarousel(currentChatFiles.length - 1);
                }
            };

            window.openCarousel = function(index) {
                if (currentChatFiles.length === 0 || index < 0 || index >= currentChatFiles.length) return;

                currentCarouselIndex = index;
                const file = currentChatFiles[currentCarouselIndex];

                const modal = document.getElementById('preview-modal');
                const content = document.getElementById('preview-content');
                const downloadLink = document.getElementById('preview-download-link');
                const detailsPanel = document.getElementById('preview-details');
                const fileName = document.getElementById('preview-filename');
                const fileAuthor = document.getElementById('preview-author');
                const fileDate = document.getElementById('preview-date');
                const fileSize = document.getElementById('preview-size');
                const prevBtn = document.getElementById('carousel-prev');
                const nextBtn = document.getElementById('carousel-next');
                const roomTitle = document.getElementById('preview-room-title');

                if (roomTitle) roomTitle.innerText = `Archivos de: ${chatContext.name || 'Chat'}`;

                if (content) content.innerHTML = '<div class="w-8 h-8 border-4 border-emerald-500 border-t-transparent rounded-full animate-spin"></div>';

                // Mostrar/ocultar botón de descarga según el tipo
                if (downloadLink) {
                    downloadLink.href = file.url;
                    downloadLink.style.display = file.type === 'youtube' ? 'none' : 'flex';
                }

                if (detailsPanel && fileName) {
                    fileName.textContent = file.name || 'Archivo adjunto';
                    fileAuthor.innerHTML = `Subido por <b>${file.uploadedBy}</b>`;
                    fileDate.textContent = file.date;

                    let sizeDisplay = 'Tamaño desconocido';
                    if (file.type === 'youtube') sizeDisplay = 'Vídeo en línea';
                    else if (file.size && !isNaN(file.size) && file.size > 0) {
                        const mb = (file.size / (1024 * 1024)).toFixed(2);
                        sizeDisplay = mb > 0.01 ? `${mb} MB` : `${(file.size / 1024).toFixed(2)} KB`;
                    }
                    fileSize.textContent = sizeDisplay;

                    detailsPanel.classList.remove('hidden');
                }

                setTimeout(() => {
                    if (file.type === 'youtube') {
                        content.innerHTML = `<iframe src="https://www.youtube.com/embed/${file.videoId}?autoplay=1" class="w-full h-[80vh] rounded-lg shadow-2xl" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
                    } else if (file.type === 'image') {
                        content.innerHTML = `<img src="${file.url}" class="max-w-full max-h-[80vh] rounded-lg shadow-2xl object-contain animate-fade-in" alt="Imagen">`;
                    } else if (file.type === 'pdf') {
                        content.innerHTML = `<iframe src="${file.url}" class="w-full h-[80vh] rounded-lg shadow-2xl bg-white" frameborder="0"></iframe>`;
                    } else {
                        content.innerHTML = `
                        <div class="text-center text-gray-300 flex flex-col items-center">
                            <svg class="w-24 h-24 mb-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                            <p class="mb-4">No hay vista previa disponible para este archivo.</p>
                            <a href="${file.url}" download class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2 px-6 rounded-xl transition-colors inline-flex items-center gap-2 pointer-events-auto">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                                Descargar archivo
                            </a>
                        </div>`;
                    }
                }, 50);

                if (prevBtn && nextBtn) {
                    if (currentChatFiles.length > 1) {
                        prevBtn.classList.remove('hidden');
                        nextBtn.classList.remove('hidden');
                        prevBtn.style.opacity = currentCarouselIndex === 0 ? '0.3' : '1';
                        nextBtn.style.opacity = currentCarouselIndex === currentChatFiles.length - 1 ? '0.3' : '1';
                    } else {
                        prevBtn.classList.add('hidden');
                        nextBtn.classList.add('hidden');
                    }
                }

                modal?.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            };

            window.navigateCarousel = function(direction) {
                let newIndex = currentCarouselIndex + direction;
                if (newIndex < 0 || newIndex >= currentChatFiles.length) return;
                window.openCarousel(newIndex);
            };

            window.closePreview = function() {
                document.getElementById('preview-modal')?.classList.add('hidden');
                const content = document.getElementById('preview-content');
                if (content) content.innerHTML = ''; // Limpiar para detener vídeos
                document.body.style.overflow = '';
            };

            document.getElementById('preview-modal')?.addEventListener('click', function(e) {
                if (e.target === this) window.closePreview();
            });

            document.addEventListener('keydown', (e) => {
                const modal = document.getElementById('preview-modal');
                if (!modal || modal.classList.contains('hidden')) return;
                if (e.key === 'Escape') window.closePreview();
                if (e.key === 'ArrowRight') window.navigateCarousel(1);
                if (e.key === 'ArrowLeft') window.navigateCarousel(-1);
            });

            window.addEventListener('beforeunload', () => {
                if (typeof activeEventSource !== 'undefined' && activeEventSource) activeEventSource.close();
                if (typeof globalEventSource !== 'undefined' && globalEventSource) globalEventSource.close();
            });

            /* ====================================================================
               1. GESTIÓN DEL TEMA Y MODALES
               ==================================================================== */
            const initTheme = () => {
                const html = document.documentElement;
                if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                    html.classList.add('dark');
                }
                window.toggleTheme = () => {
                    if (html.classList.contains('dark')) {
                        html.classList.remove('dark');
                        localStorage.setItem('theme', 'light');
                    } else {
                        html.classList.add('dark');
                        localStorage.setItem('theme', 'dark');
                    }
                };
            };

            window.openModal = (id) => document.getElementById(id).classList.remove('hidden');
            window.closeModal = (id) => document.getElementById(id).classList.add('hidden');
            window.switchModal = (closeId, openId) => { window.closeModal(closeId); window.openModal(openId); };

            const showFormError = (id, msg) => {
                const el = document.getElementById(id);
                el.querySelector('span').textContent = msg;
                el.classList.remove('hidden');
            };
            const hideFormError = (id) => document.getElementById(id).classList.add('hidden');

            ['login-modal', 'register-modal'].forEach(id => {
                const modal = document.getElementById(id);
                if(modal) modal.addEventListener('click', (e) => { if (e.target === modal) window.closeModal(id); });
            });

            /* ====================================================================
               2. VALIDACIÓN Y FORMULARIOS
               ==================================================================== */
            let typingTimer;
            const checkAvailability = async (type, value, spinnerId) => {
                if (value.length < 3) return;
                const spinner = document.getElementById(spinnerId);
                if(spinner) spinner.classList.remove('hidden');
                hideFormError('reg-error-msg');
                try {
                    const response = await fetch(`/check-availability?${type}=${encodeURIComponent(value)}`);
                    if (response.ok && response.headers.get("content-type")?.includes("application/json")) {
                        const data = await response.json();
                        if (!data.available) showFormError('reg-error-msg', `El ${type === 'username' ? 'usuario' : 'email'} ya está en uso.`);
                    }
                } catch (e) {
                    console.warn(`Endpoint /check-availability no encontrado.`);
                } finally {
                    if(spinner) spinner.classList.add('hidden');
                }
            };

            document.getElementById('reg-username')?.addEventListener('keyup', function() {
                clearTimeout(typingTimer);
                typingTimer = setTimeout(() => checkAvailability('username', this.value, 'user-check-spinner'), 800);
            });

            document.getElementById('reg-email')?.addEventListener('keyup', function() {
                clearTimeout(typingTimer);
                typingTimer = setTimeout(() => checkAvailability('email', this.value, 'email-check-spinner'), 800);
            });

            document.getElementById('register-form')?.addEventListener('submit', async function(e) {
                e.preventDefault();
                hideFormError('reg-error-msg');

                const email = document.getElementById('reg-email').value;
                const pass = document.getElementById('reg-password').value;
                const confirm = document.getElementById('reg-confirm-password').value;

                if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return showFormError('reg-error-msg', 'Formato de correo inválido.');
                if (!/^(?=.*[A-Z])(?=.*\d).{8,}$/.test(pass)) return showFormError('reg-error-msg', 'Contraseña: 8+ caracteres, 1 mayúscula y 1 número.');
                if (pass !== confirm) return showFormError('reg-error-msg', 'Las contraseñas no coinciden.');

                const btn = document.getElementById('reg-submit-btn');
                const originalText = btn.innerText;
                btn.disabled = true;
                btn.innerText = "Procesando...";

                try {
                    const searchParams = new URLSearchParams(new FormData(this));
                    const response = await fetch(this.action, { method: 'POST', body: searchParams, headers: { 'Content-Type': 'application/x-www-form-urlencoded' } });

                    if (response.redirected) {
                        Swal.fire({ icon: 'success', title: '¡Éxito!', text: 'Cuenta creada.', confirmButtonColor: '#065f46' });
                        window.location.href = response.url;
                        return;
                    }
                    showFormError('reg-error-msg', 'Error de validación. Es posible que el usuario ya exista.');
                } catch (err) {
                    showFormError('reg-error-msg', 'Error al contactar con el servidor.');
                } finally {
                    btn.disabled = false;
                    btn.innerText = originalText;
                }
            });

            document.getElementById('login-form')?.addEventListener('submit', async function(e) {
                e.preventDefault();
                hideFormError('login-error-msg');

                const btn = this.querySelector('button[type="submit"]');
                const originalText = btn.innerText;
                btn.disabled = true;
                btn.innerText = "Autenticando...";

                try {
                    const searchParams = new URLSearchParams(new FormData(this));
                    const response = await fetch(this.action, { method: 'POST', body: searchParams, headers: { 'Content-Type': 'application/x-www-form-urlencoded' } });

                    if (response.url.endsWith('/login')) {
                        showFormError('login-error-msg', 'Usuario o contraseña incorrectos.');
                    } else {
                        window.location.reload();
                    }
                } catch (err) {
                    showFormError('login-error-msg', 'Error de conexión.');
                } finally {
                    btn.disabled = false;
                    btn.innerText = originalText;
                }
            });

            /* ====================================================================
               3. CHAT, MERCURE Y NOTIFICACIONES
               ==================================================================== */
            {% if app.user %}
            const username = '{{ app.user.username|e('js') }}';
            const userId = '{{ app.user.id }}';
            const mercureUrl = new URL('/.well-known/mercure', window.location.origin);

            let chatContext = { type: 'sala', id: null, name: '' };
            let activeEventSource = null;
            let globalEventSource = null;
            let typingTimeout = null;

            const searchInput = document.getElementById('sidebar-search');
            if (searchInput) {
                searchInput.addEventListener('input', function(e) {
                    const term = e.target.value.toLowerCase();
                    const salas = document.querySelectorAll('#list-salas > div');
                    salas.forEach(sala => {
                        const nombre = sala.querySelector('span').innerText.toLowerCase();
                        sala.style.display = nombre.includes(term) ? 'flex' : 'none';
                    });
                    const usuarios = document.querySelectorAll('#list-users > div:not(p)');
                    usuarios.forEach(usuario => {
                        const nombre = usuario.querySelector('span').innerText.toLowerCase();
                        usuario.style.display = nombre.includes(term) ? 'flex' : 'none';
                    });
                });
            }

            const chatSidebar = document.getElementById('chatSidebar');
            const toggleBtn = document.getElementById('toggleChatBtn');
            const chatContainer = document.getElementById('chat-messages-container');
            const chatInput = document.getElementById('global-chat-input');
            const fileInput = document.getElementById('chat-file-input');
            const activeChatWindow = document.getElementById('active-chat-window');
            const notificationSound = document.getElementById('notification-sound');

            function clearUnreadSeparator() {
                const sep = document.getElementById('unread-separator');
                if (sep) {
                    sep.style.opacity = '0';
                    setTimeout(() => sep.remove(), 500);
                }
            }

            function connectGlobalMercure() {
                const globalTopic = `https://brainhub.com/notifs/${userId}`;
                const url = new URL(mercureUrl);
                url.searchParams.append('topic', globalTopic);

                globalEventSource = new EventSource(url);
                globalEventSource.onmessage = event => {
                    const data = JSON.parse(event.data);
                    if (chatContext.id == data.salaId && !chatSidebar?.classList.contains('w-0')) return;
                    if (data.autor === username) return;

                    const chatKey = data.salaId ? `sala_${data.salaId}` : `user_${data.remitenteId}`;
                    let unreadCounts = JSON.parse(localStorage.getItem('chat_unread')) || {};
                    unreadCounts[chatKey] = (unreadCounts[chatKey] || 0) + 1;
                    localStorage.setItem('chat_unread', JSON.stringify(unreadCounts));

                    if(notificationSound) notificationSound.play().catch(() => console.log('Auto-play bloqueado'));

                    const isDark = document.documentElement.classList.contains('dark');
                    Swal.fire({
                        toast: true, position: 'top-end', showConfirmButton: false, timer: 5000, timerProgressBar: true,
                        background: isDark ? '#1f2937' : '#ffffff', color: isDark ? '#f3f4f6' : '#1f2937',
                        customClass: { popup: 'rounded-2xl shadow-xl border border-emerald-500/20' },
                        html: `
                            <div class="flex items-center gap-4 cursor-pointer text-left">
                                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-emerald-400 to-emerald-600 flex items-center justify-center text-white font-bold text-xl shadow-lg shrink-0">
                                    ${data.autor.charAt(0).toUpperCase()}
                                </div>
                                <div class="overflow-hidden flex-1">
                                    <p class="font-bold text-sm m-0 truncate">${data.autor} <span class="text-xs font-normal opacity-60">en ${data.salaNombre || 'Privado'}</span></p>
                                    <p class="text-xs mt-1 truncate opacity-80">${data.contenido || '📁 Archivo adjunto'}</p>
                                </div>
                            </div>
                        `,
                        didOpen: (toast) => {
                            toast.addEventListener('mouseenter', Swal.stopTimer);
                            toast.addEventListener('mouseleave', Swal.resumeTimer);
                            toast.addEventListener('click', () => {
                                window.switchChat(data.salaId ? 'sala' : 'user', data.salaId || data.remitenteId, data.salaNombre || data.autor);
                                Swal.close();
                            });
                        }
                    });

                    document.getElementById('global-notif-badge')?.classList.remove('hidden');
                    const list = document.getElementById('notif-list');
                    if (list) {
                        if (list.querySelector('p')) list.innerHTML = '';
                        list.innerHTML = `<div onclick="window.switchChat('${data.salaId ? 'sala' : 'user'}', ${data.salaId || data.remitenteId}, '${data.salaNombre || data.autor}')" class="px-4 py-3 border-b border-gray-100 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 cursor-pointer transition-colors"><p class="text-sm font-bold text-gray-800 dark:text-gray-100">${data.autor}</p><p class="text-xs text-gray-500 dark:text-gray-400 truncate">${data.contenido || 'Archivo adjunto'}</p></div>` + list.innerHTML;
                    }
                };
            }
            if(document.getElementById('notifMenuBtn')) connectGlobalMercure();

            window.switchChat = function(type, id, name) {
                currentChatFiles = [];

                chatContext = { type, id, name };
                document.getElementById('active-chat-title').innerText = name;
                document.getElementById('active-chat-subtitle').innerText = type === 'sala' ? 'Canal de Sala' : 'Mensaje Directo';
                activeChatWindow.classList.remove('hidden');

                chatContainer.innerHTML = '<div class="flex justify-center items-center h-full"><span class="text-sm text-gray-400 dark:text-gray-500 font-bold uppercase tracking-widest animate-pulse">Cargando...</span></div>';

                fetch(`/chat/history/${type}/${id}`)
                    .then(r => r.json())
                    .then(mensajes => {
                        chatContainer.innerHTML = '';

                        const chatKey = `${type}_${id}`;
                        let unreadCounts = JSON.parse(localStorage.getItem('chat_unread')) || {};
                        const newMessagesCount = unreadCounts[chatKey] || 0;
                        const totalMessages = mensajes.length;

                        if (totalMessages === 0) {
                            chatContainer.innerHTML = '<p class="text-center text-xs text-gray-400 dark:text-gray-500 py-10 uppercase font-bold">Inicia la conversación</p>';
                        } else {
                            const startIndex = Math.max(0, totalMessages - newMessagesCount);

                            mensajes.forEach((data, index) => {
                                if (newMessagesCount > 0 && index === startIndex) {
                                    const sep = document.createElement('div');
                                    sep.id = 'unread-separator';
                                    sep.className = 'w-full flex justify-center my-6 opacity-100 transition-opacity duration-500';
                                    sep.innerHTML = `<span class="bg-emerald-100 dark:bg-emerald-900/40 text-emerald-800 dark:text-emerald-300 text-[10px] font-black uppercase tracking-widest px-4 py-1.5 rounded-full shadow-sm border border-emerald-200 dark:border-emerald-700/50">${newMessagesCount} Mensaje(s) Nuevo(s)</span>`;
                                    chatContainer.appendChild(sep);
                                }
                                renderMessageToChat(data, data.autor === username);
                            });
                        }

                        const separator = document.getElementById('unread-separator');
                        if (separator) {
                            setTimeout(() => separator.scrollIntoView({ behavior: 'smooth', block: 'center' }), 100);
                            unreadCounts[chatKey] = 0;
                            localStorage.setItem('chat_unread', JSON.stringify(unreadCounts));
                        } else {
                            chatContainer.scrollTo({ top: chatContainer.scrollHeight });
                        }

                        connectActiveChatMercure();
                    });

                if (chatSidebar?.classList.contains('w-0')) toggleBtn.click();
            };

            window.closeChat = function() {
                activeChatWindow?.classList.add('hidden');
                if (activeEventSource) activeEventSource.close();

                if (chatSidebar && chatSidebar.classList.contains('w-0')) {
                    document.getElementById('toggleChatBtn')?.click();
                }
            };

            function connectActiveChatMercure() {
                if (activeEventSource) activeEventSource.close();
                const topic = chatContext.type === 'sala' ? `https://brainhub.com/sala/${chatContext.id}` : `https://brainhub.com/user/${chatContext.id}`;
                const url = new URL(mercureUrl);
                url.searchParams.append('topic', topic);

                activeEventSource = new EventSource(url);
                activeEventSource.onmessage = event => {
                    const data = JSON.parse(event.data);

                    if (data.isTyping) {
                        if (data.autor !== username) {
                            document.getElementById('typing-user').innerText = data.autor;
                            document.getElementById('typing-indicator').classList.remove('hidden');
                            clearTimeout(typingTimeout);
                            typingTimeout = setTimeout(() => document.getElementById('typing-indicator').classList.add('hidden'), 3000);
                        }
                        return;
                    }

                    document.getElementById('typing-indicator')?.classList.add('hidden');
                    renderMessageToChat(data, data.autor === username);
                };
            }

            function renderMessageToChat(data, isMe) {
                const loadingTxt = chatContainer.querySelector('p.text-center');
                if (loadingTxt) loadingTxt.remove();

                const safeAuthor = document.createTextNode(data.autor).textContent;
                const safeContent = document.createTextNode(data.contenido || '').textContent;

                // --- YouTube Detection ---
                let youtubeHtml = '';
                const ytId = extractYouTubeId(safeContent);
                if (ytId) {
                    const ytEmbedUrl = `https://www.youtube.com/embed/${ytId}`;
                    const ytThumb = `https://img.youtube.com/vi/${ytId}/mqdefault.jpg`;
                    const fileIndex = registerFileInCarousel(ytEmbedUrl, 'youtube', 'Video de YouTube', data.autor, data.fechaCreacion, null, ytId);

                    youtubeHtml = `
                    <div class="mt-2 group relative cursor-pointer overflow-hidden rounded-lg border ${isMe ? 'border-emerald-400 dark:border-emerald-500' : 'border-gray-200 dark:border-gray-600'} shadow-sm" onclick="openCarousel(${fileIndex})">
                        <img src="${ytThumb}" class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-300">
                        <div class="absolute inset-0 bg-black/30 flex items-center justify-center opacity-90 group-hover:opacity-100 transition-opacity">
                            <svg class="w-12 h-12 text-white drop-shadow-lg" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                        </div>
                    </div>`;
                }

                let fileHtml = '';
                if (data.archivoUrl) {
                    const url = data.archivoUrl;
                    const ext = url.split('.').pop().toLowerCase();

                    let fileType = 'other';
                    if (['jpg', 'jpeg', 'png', 'gif', 'webp'].includes(ext)) fileType = 'image';
                    else if (ext === 'pdf') fileType = 'pdf';

                    const fileIndex = registerFileInCarousel(url, fileType, data.archivoNombre, data.autor, data.fechaCreacion, data.archivoTamano);

                    if (fileType === 'image') {
                        fileHtml = `
                                <div class="mt-2 group relative cursor-zoom-in overflow-hidden rounded-lg border ${isMe ? 'border-emerald-400 dark:border-emerald-500' : 'border-gray-200 dark:border-gray-600'} shadow-sm" onclick="openCarousel(${fileIndex})">
                                    <img src="${url}" class="max-h-48 w-full object-cover group-hover:scale-105 transition-transform duration-300">
                                    <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg>
                                    </div>
                                </div>`;
                    } else if (fileType === 'pdf') {
                        fileHtml = `
                                <div class="mt-2 flex items-center gap-3 p-3 rounded-xl cursor-pointer border ${isMe ? 'bg-emerald-700/50 border-emerald-400' : 'bg-gray-100 dark:bg-gray-800/80 border-gray-200 dark:border-gray-600'} hover:opacity-80 transition-all" onclick="openCarousel(${fileIndex})">
                                    <div class="bg-red-500 p-2 rounded-lg text-white">
                                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path d="M9 2a2 2 0 00-2 2v8a2 2 0 002 2h6a2 2 0 002-2V6l-4-4H9z"/><path d="M10 14h4a1 1 0 011 1v3a1 1 0 11-2 0v-1h-1v1a1 1 0 11-2 0v-3a1 1 0 011-1z"/></svg>
                                    </div>
                                    <div class="overflow-hidden">
                                        <p class="text-[11px] font-bold truncate">${data.archivoNombre || 'Ver PDF'}</p>
                                        <p class="text-[9px] opacity-70 uppercase font-black tracking-tighter">Documento PDF • Click para ver</p>
                                    </div>
                                </div>`;
                    } else {
                        // --- MODIFICADO: Archivos genéricos abren previsualización ---
                        fileHtml = `
                                <div class="mt-2 flex items-center gap-3 p-3 rounded-xl cursor-pointer border ${isMe ? 'bg-emerald-700/50 border-emerald-400' : 'bg-gray-100 dark:bg-gray-800/80 border-gray-200 dark:border-gray-600'} hover:opacity-80 transition-all" onclick="openCarousel(${fileIndex})">
                                    <div class="bg-blue-500 p-2 rounded-lg text-white">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                                    </div>
                                    <div class="overflow-hidden">
                                        <p class="text-[11px] font-bold truncate">${data.archivoNombre || 'Archivo'}</p>
                                        <p class="text-[9px] opacity-70 uppercase font-black tracking-tighter">Click para ver / Descargar</p>
                                    </div>
                                </div>`;
                    }
                }

                const div = document.createElement('div');
                div.className = `flex flex-col ${isMe ? 'items-end' : 'items-start'} animate-fade-in mb-4`;

                const bubbleClasses = isMe
                    ? 'bg-emerald-600 text-white rounded-l-2xl rounded-tr-2xl shadow-md border border-emerald-500'
                    : 'bg-white dark:bg-gray-800 text-gray-800 dark:text-gray-100 border border-gray-200 dark:border-gray-700 rounded-r-2xl rounded-tl-2xl shadow-sm';

                div.innerHTML = `
                        <span class="text-[10px] text-gray-400 dark:text-gray-500 font-bold mb-1 px-1 uppercase">${safeAuthor}</span>
                        <div class="px-4 py-3 text-sm max-w-[85%] ${bubbleClasses}">
                            ${safeContent ? `<p class="whitespace-pre-wrap break-words">${safeContent}</p>` : ''}
                            ${youtubeHtml}
                            ${fileHtml}
                        </div>
                    `;

                chatContainer?.appendChild(div);

                if (!document.getElementById('unread-separator')) {
                    chatContainer?.scrollTo({ top: chatContainer.scrollHeight, behavior: 'smooth' });
                }
            }

            window.updateFilePreview = function(input) {
                if (input.files.length > 0) {
                    document.getElementById('file-preview-name').innerText = input.files[0].name;
                    document.getElementById('file-preview')?.classList.remove('hidden');
                    if(chatInput) chatInput.placeholder = "Añade un comentario...";
                }
            };

            window.clearFile = function() {
                if(fileInput) fileInput.value = '';
                document.getElementById('file-preview')?.classList.add('hidden');
                if(chatInput) chatInput.placeholder = "Escribe un mensaje...";
            };

            const sendMessage = () => {
                if(!chatInput) return;
                const text = chatInput.value.trim();
                const file = fileInput?.files[0];

                if (!text && !file) return;

                const formData = new FormData();
                if (text) formData.append('mensaje', text);
                if (file) formData.append('archivo', file);
                if (chatContext.type === 'sala') formData.append('salaId', chatContext.id);
                else formData.append('receptorId', chatContext.id);

                fetch('{{ path("app_chat_send") }}', { method: 'POST', body: formData })
                    .catch(err => console.error("Error", err));

                chatInput.value = '';
                clearFile();
                clearUnreadSeparator();
            };

            document.getElementById('send-chat-btn')?.addEventListener('click', sendMessage);
            chatInput?.addEventListener('keypress', (e) => { if (e.key === 'Enter') sendMessage(); });

            chatInput?.addEventListener('focus', clearUnreadSeparator);
            chatInput?.addEventListener('click', clearUnreadSeparator);

            let emitTypingTimeout;
            chatInput?.addEventListener('input', () => {
                clearTimeout(emitTypingTimeout);
                fetch(`/chat/typing/${chatContext.type}/${chatContext.id}`, { method: 'POST' });
                emitTypingTimeout = setTimeout(() => {}, 2000);
            });

            toggleBtn?.addEventListener('click', () => {
                const isClosed = chatSidebar.classList.contains('w-0');
                chatSidebar.classList.toggle('w-0', !isClosed);
                chatSidebar.classList.toggle('w-80', isClosed);
                chatSidebar.classList.toggle('md:w-[400px]', isClosed);
                document.getElementById('chatIcon')?.classList.toggle('hidden');
                document.getElementById('arrowIcon')?.classList.toggle('hidden');
            });

            window.switchTab = function(tab) {
                const isS = tab === 'salas';
                document.getElementById('list-salas')?.classList.toggle('hidden', !isS);
                document.getElementById('list-users')?.classList.toggle('hidden', isS);
                document.getElementById('tab-salas').className = isS ? 'flex-1 py-4 text-xs font-black uppercase tracking-widest border-b-2 border-emerald-500 text-emerald-600' : 'flex-1 py-4 text-xs font-black uppercase tracking-widest border-b-2 border-transparent text-gray-400 hover:text-emerald-500';
                document.getElementById('tab-users').className = !isS ? 'flex-1 py-4 text-xs font-black uppercase tracking-widest border-b-2 border-emerald-500 text-emerald-600' : 'flex-1 py-4 text-xs font-black uppercase tracking-widest border-b-2 border-transparent text-gray-400 hover:text-emerald-500';
            };

            const toggleMenu = (btnId, menuId) => {
                document.getElementById(btnId)?.addEventListener('click', (e) => {
                    e.stopPropagation();
                    document.getElementById(menuId)?.classList.toggle('hidden');
                    if(btnId === 'notifMenuBtn') document.getElementById('global-notif-badge')?.classList.add('hidden');
                });
            };
            toggleMenu('userMenuBtn', 'userDropdown');
            toggleMenu('notifMenuBtn', 'notifDropdown');

            document.addEventListener('click', () => {
                document.getElementById('userDropdown')?.classList.add('hidden');
                document.getElementById('notifDropdown')?.classList.add('hidden');
            });

            {% endif %}

            const flashMessages = {
                {% for label, messages in app.flashes %}
                "{{ label }}": [
                    {% for message in messages %}
                    "{{ message|e('js') }}",
                    {% endfor %}
                ],
                {% endfor %}
            };

            const isDark = document.documentElement.classList.contains('dark');

            for (const [type, messages] of Object.entries(flashMessages)) {
                messages.forEach(message => {
                    Swal.fire({
                        icon: type === 'error' ? 'error' : (type === 'warning' ? 'warning' : 'success'),
                        title: type === 'error' ? '¡Oops!' : (type === 'warning' ? 'Atención' : '¡Éxito!'),
                        text: message,
                        confirmButtonColor: '#10b981',
                        background: isDark ? '#1e293b' : '#ffffff',
                        color: isDark ? '#f3f4f6' : '#1f2937',
                        timer: type === 'success' ? 3000 : null,
                        timerProgressBar: true,
                        toast: type === 'success',
                        position: type === 'success' ? 'top-end' : 'center',
                        showConfirmButton: type !== 'success'
                    });
                });
            }

            initTheme();
        });
    </script>
