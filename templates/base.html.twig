<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}BrainHub - Estudio Colaborativo{% endblock %}</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    {% block stylesheets %}{% endblock %}

    <style>
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .animate-fade-in { animation: fadeIn 0.4s ease-out forwards; }
        .dropdown-menu.hidden { display: none; }

        /* Efecto de pulso suave para el botón de chat cuando está cerrado */
        .chat-hint-pulse {
            animation: pulse-green 2s infinite;
        }
        @keyframes pulse-green {
            0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); }
            70% { box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
            100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
        }
    </style>
</head>

<body class="bg-[#f3f4f6] font-sans antialiased text-gray-900 flex flex-col {% if app.user %}h-screen overflow-hidden{% else %}min-h-screen{% endif %}">

{# --- NAVBAR --- #}
<nav class="bg-emerald-800 shadow-md z-50 shrink-0 relative">
    <div class="w-full px-6 md:px-10">
        <div class="flex justify-between h-16 items-center">
            <a href="{{ path('app_home') }}" class="flex items-center gap-2 text-white font-bold text-xl hover:text-emerald-200 transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
                <span>BrainHub</span>
            </a>

            <div class="flex items-center space-x-4">
                {% if app.user %}
                    <div class="relative">
                        <button id="userMenuBtn" class="flex items-center gap-3 bg-emerald-700/50 py-1.5 pl-4 pr-2 rounded-full border border-emerald-600/50 hover:bg-emerald-700 transition-all outline-none">
                            <span class="text-emerald-50 text-sm font-medium">Hola, <span class="text-white font-bold">{{ app.user.username }}</span></span>
                            <div class="h-9 w-9 bg-emerald-500 rounded-full flex items-center justify-center text-white font-black border-2 border-emerald-300 shadow-sm uppercase text-xs">
                                {{ app.user.username|first }}
                            </div>
                        </button>
                        <div id="userDropdown" class="dropdown-menu hidden absolute right-0 mt-2 w-56 bg-white rounded-2xl shadow-2xl border border-gray-100 py-2 z-[100] animate-fade-in">
                            <div class="px-4 py-3 border-b border-gray-50 mb-1">
                                <p class="text-[10px] uppercase tracking-widest text-gray-400 font-bold">Cuenta</p>
                                <p class="text-sm font-bold text-gray-800 truncate">{{ app.user.email|default(app.user.username) }}</p>
                            </div>
                            <a href="{{ path('app_logout') }}" class="flex items-center gap-3 px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 transition-colors font-bold">
                                Cerrar sesión
                            </a>
                        </div>
                    </div>
                {% else %}
                    <a href="{{ path('app_login') }}" class="text-emerald-50 hover:text-white font-medium transition-all hover:underline underline-offset-4">Iniciar sesión</a>
                    <a href="{{ path('app_register') }}" class="bg-emerald-500 hover:bg-emerald-400 text-white px-5 py-2 rounded-xl font-bold shadow-lg transition-all transform hover:scale-105">Registrarse</a>
                {% endif %}
            </div>
        </div>
    </div>
</nav>

{# --- CONTENEDOR PRINCIPAL DUAL --- #}
<div class="flex flex-grow w-full relative {% if app.user %}overflow-hidden{% endif %}">

    {# 1. ÁREA DINÁMICA (Main) #}
    <main class="flex-grow w-full relative flex flex-col transition-all duration-500 ease-in-out {% if app.user %}overflow-y-auto{% endif %}">
        <div class="flex-grow">
            {% block body %}{% endblock %}
        </div>

        {% if app.user %}
            <footer class="w-full bg-emerald-900 text-center py-3 text-emerald-300/60 text-[10px] shrink-0 border-t border-emerald-800">
                &copy; {{ "now"|date("Y") }} - BrainHub - Estudio Colaborativo.
            </footer>
        {% endif %}
    </main>

    {# 2. CHAT LATERAL GLOBAL (Inicia con w-0) #}
    {% if app.user %}
        {# QUITAMOS 'overflow-hidden' de aquí para que el botón pueda asomar #}
        <aside id="chatSidebar" class="relative h-full w-0 flex flex-col transition-all duration-500 ease-in-out z-40 shrink-0">

            {# Botón de Toggle (Visible siempre) #}
            <button id="toggleChatBtn" class="absolute left-0 top-1/2 -translate-y-1/2 transform -translate-x-full bg-emerald-600 text-white p-3 rounded-l-2xl shadow-lg hover:bg-emerald-700 transition-all z-50 flex flex-col items-center gap-2 chat-hint-pulse" title="Abrir Chat">
                {# Icono de Chat (visible cuando está cerrado) #}
                <svg id="chatIcon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
                </svg>
                {# Icono de Flecha (visible cuando está abierto, rotará) #}
                <svg id="arrowIcon" class="w-4 h-4 transition-transform duration-500 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"></path>
                </svg>
                <span id="chatLabel" class="[writing-mode:vertical-lr] rotate-180 text-[10px] font-bold tracking-widest uppercase py-1">Chat</span>
            </button>

            {# NUEVO CONTENEDOR: Este div sí oculta el contenido y tiene el fondo blanco #}
            <div class="h-full w-full bg-white shadow-2xl overflow-hidden flex flex-col transition-all duration-500">
                {# Wrapper del contenido con ancho mínimo fijo #}
                <div class="min-w-[20rem] md:min-w-[24rem] h-full flex flex-col border-l border-gray-100">

                    <div class="p-6 border-b border-gray-50 shrink-0 flex justify-between items-center">
                        <h2 class="text-xl font-black text-gray-900">Mensajes</h2>
                        <span class="flex h-2 w-2 rounded-full bg-emerald-500"></span>
                    </div>

                    <div class="flex-grow overflow-y-auto p-6 space-y-4 bg-gray-50/50">
                        <div class="p-4 bg-emerald-50 rounded-2xl border border-emerald-100">
                            <p class="text-sm text-emerald-800 font-medium leading-relaxed">¡Bienvenido a BrainHub! Tu chat global está activo.</p>
                        </div>
                    </div>

                    <div class="p-4 bg-white border-t border-gray-100 shrink-0">
                        <input type="text" placeholder="Escribe un mensaje..." class="w-full p-3 rounded-xl bg-gray-50 border border-gray-200 text-sm outline-none focus:ring-2 focus:ring-emerald-500 transition-all">
                    </div>

                </div>
            </div>

        </aside>
    {% endif %}

</div>

{# --- SCRIPTS GLOBALES --- #}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Dropdown Perfil
        const userBtn = document.getElementById('userMenuBtn');
        const userMenu = document.getElementById('userDropdown');
        if (userBtn && userMenu) {
            userBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                userMenu.classList.toggle('hidden');
            });
            document.addEventListener('click', () => userMenu.classList.add('hidden'));
        }

        // Lógica del Chat (Minimizar/Maximizar)
        const chatSidebar = document.getElementById('chatSidebar');
        const toggleBtn = document.getElementById('toggleChatBtn');
        const arrowIcon = document.getElementById('arrowIcon');
        const chatIcon = document.getElementById('chatIcon');
        const chatLabel = document.getElementById('chatLabel');

        if (chatSidebar && toggleBtn) {
            toggleBtn.addEventListener('click', () => {
                const isClosed = chatSidebar.classList.contains('w-0');

                if (isClosed) {
                    // ABRIR
                    chatSidebar.classList.remove('w-0');
                    chatSidebar.classList.add('w-80', 'md:w-96');

                    // Ajustes de Iconos
                    chatIcon.classList.add('hidden');
                    arrowIcon.classList.remove('hidden');
                    arrowIcon.classList.remove('rotate-180');
                    chatLabel.classList.add('hidden');
                    toggleBtn.classList.remove('chat-hint-pulse');
                    toggleBtn.classList.replace('bg-emerald-600', 'bg-white');
                    toggleBtn.classList.replace('text-white', 'text-gray-400');
                    toggleBtn.title = "Cerrar Chat";
                } else {
                    // CERRAR
                    chatSidebar.classList.remove('w-80', 'md:w-96');
                    chatSidebar.classList.add('w-0');

                    // Ajustes de Iconos
                    chatIcon.classList.remove('hidden');
                    arrowIcon.classList.add('hidden');
                    chatLabel.classList.remove('hidden');
                    toggleBtn.classList.add('chat-hint-pulse');
                    toggleBtn.classList.replace('bg-white', 'bg-emerald-600');
                    toggleBtn.classList.replace('text-gray-400', 'text-white');
                    toggleBtn.title = "Abrir Chat";
                }
            });
        }
    });
</script>

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 4000,
                timerProgressBar: true,
                customClass: { container: 'z-[9999]' },
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer)
                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                }
            });

            {% for message in app.flashes('success') %}
            Toast.fire({ icon: 'success', title: '{{ message|e('js') }}', customClass: { popup: 'rounded-2xl shadow-xl border border-gray-100 mt-16 mr-4' } });
            {% endfor %}

            {% for message in app.flashes('error') %}
            Toast.fire({ icon: 'error', title: '{{ message|e('js') }}', customClass: { popup: 'rounded-2xl shadow-xl border border-gray-100 mt-16 mr-4' } });
            {% endfor %}

            // Botón eliminar sala
            document.querySelectorAll('.form-eliminar-sala').forEach(form => {
                const btn = form.querySelector('.btn-eliminar');
                if(btn) {
                    btn.addEventListener('click', (e) => {
                        e.preventDefault();
                        Swal.fire({
                            title: '¿Estás seguro?',
                            text: "Esta acción no se puede deshacer.",
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonColor: '#dc2626',
                            confirmButtonText: 'Sí, eliminar',
                            cancelButtonText: 'Cancelar',
                            customClass: { popup: 'rounded-3xl', confirmButton: 'rounded-xl px-6 py-3', cancelButton: 'rounded-xl px-6 py-3' }
                        }).then((result) => { if (result.isConfirmed) form.submit(); });
                    });
                }
            });
        });
    </script>
{% endblock %}
</body>
</html>
