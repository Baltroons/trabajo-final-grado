{% extends 'base.html.twig' %}

{% block body %}
    <div class="relative w-full h-[calc(100vh-64px)] flex flex-col items-center justify-center overflow-hidden">
        <img src="{{ asset('images/brainhub.png') }}" class="absolute inset-0 w-full h-full object-cover">
        <div class="absolute inset-0 bg-emerald-950/40 backdrop-blur-[2px]"></div>

        <div class="relative z-10 w-full max-w-md mx-4 bg-white/95 backdrop-blur-xl p-10 md:p-12 rounded-[40px] shadow-2xl border border-white/20 animate-fade-in">
            <div class="text-center mb-8">
                <h2 class="text-3xl font-black text-gray-900">Bienvenido</h2>
                <p class="text-gray-500 text-sm">Identifícate para entrar en tus salas</p>
            </div>

            {% if error %}<div class="bg-red-50 text-red-700 p-3 rounded-xl text-xs mb-4 border border-red-100 italic">{{ error.messageKey|trans(error.messageData, 'security') }}</div>{% endif %}

            <form method="post" class="space-y-4">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <input type="text" value="{{ last_username }}" name="_username" class="w-full px-6 py-4 bg-gray-50 border border-gray-200 rounded-2xl focus:ring-2 focus:ring-emerald-500 outline-none text-sm" placeholder="Usuario" required autofocus>
                <input type="password" name="_password" class="w-full px-6 py-4 bg-gray-50 border border-gray-200 rounded-2xl focus:ring-2 focus:ring-emerald-500 outline-none text-sm" placeholder="Contraseña" required>
                <button type="submit" class="w-full bg-emerald-800 hover:bg-emerald-900 text-white font-bold py-4 rounded-2xl transition-all shadow-lg transform hover:scale-[1.02]">Entrar ahora</button>
            </form>
            <div class="text-center mt-6"><p class="text-sm text-gray-600">¿Nuevo aquí? <a href="{{ path('app_register') }}" class="text-emerald-700 font-bold hover:underline">Regístrate</a></p></div>
        </div>
    </div>
{% endblock %}
