{% extends 'base.html.twig' %}

{% block body %}
    <div class="relative w-full h-[calc(100vh-64px)] flex flex-col items-center justify-center overflow-hidden">
        <img src="{{ asset('images/brainhub.png') }}" class="absolute inset-0 w-full h-full object-cover">
        <div class="absolute inset-0 bg-emerald-950/40 backdrop-blur-[2px]"></div>

        <div class="relative z-10 w-full max-w-md mx-4 bg-white/95 backdrop-blur-xl p-8 md:p-10 rounded-[40px] shadow-2xl border border-white/20 animate-fade-in">
            <div class="text-center mb-6">
                <h2 class="text-3xl font-black text-gray-900">Crear cuenta</h2>
                <p class="text-gray-500 text-sm">Únete a la comunidad de estudio</p>
            </div>

            {{ form_start(registrationForm, {'attr': {'class': 'space-y-4'}}) }}
            {{ form_widget(registrationForm.username, {'attr': {'class': 'w-full px-5 py-3 bg-gray-50 border border-gray-200 rounded-2xl focus:ring-2 focus:ring-emerald-500 outline-none text-sm', 'placeholder': 'Nombre de usuario'}}) }}
            {{ form_widget(registrationForm.email, {'attr': {'class': 'w-full px-5 py-3 bg-gray-50 border border-gray-200 rounded-2xl focus:ring-2 focus:ring-emerald-500 outline-none text-sm', 'placeholder': 'Email'}}) }}
            {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'w-full px-5 py-3 bg-gray-50 border border-gray-200 rounded-2xl focus:ring-2 focus:ring-emerald-500 outline-none text-sm', 'placeholder': 'Contraseña'}}) }}

            <div class="flex items-center gap-2 text-xs text-gray-600">
                {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'rounded border-gray-300 text-emerald-600'}}) }}
                <span>Acepto los términos de uso</span>
            </div>

            <button type="submit" class="w-full bg-emerald-800 hover:bg-emerald-900 text-white font-bold py-4 rounded-2xl transition-all shadow-lg transform hover:scale-[1.02]">Registrarme</button>
            {{ form_end(registrationForm) }}

            <div class="text-center mt-4"><p class="text-sm text-gray-600 text-xs">¿Ya tienes cuenta? <a href="{{ path('app_login') }}" class="text-emerald-700 font-bold hover:underline">Inicia sesión</a></p></div>
        </div>
    </div>
{% endblock %}
