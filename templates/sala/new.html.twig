{% extends 'base.html.twig' %}

{% block title %}Crear Nueva Sala — BrainHub{% endblock %}

{% block body %}
    <div class="max-w-5xl mx-auto py-8 px-4 sm:px-6 lg:px-8">

        <div class="mb-8">
            <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Lanzar un nuevo espacio</h1>
            <p class="mt-2 text-sm text-gray-500">Configura tu sala de estudio. Podrás invitar a tus compañeros y subir archivos una vez creada.</p>
        </div>

        <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-gray-200 flex flex-col lg:flex-row">

            <div class="w-full lg:w-3/5 p-8 sm:p-10">
                {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

                <div>
                    <label class="flex items-center text-sm font-semibold text-gray-800 mb-2">
                        <svg class="w-4 h-4 mr-2 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                        Nombre de la Sala / Asignatura
                    </label>
                    {{ form_widget(form.nombre, {
                        'attr': {
                            'class': 'mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm py-3 px-4 bg-gray-50 transition-colors',
                            'placeholder': 'Ej. Repaso General de Java - POO'
                        }
                    }) }}
                    <p class="mt-2 text-xs text-gray-500">Usa un nombre claro y directo para que otros estudiantes sepan de qué va.</p>
                </div>

                <div>
                    <label class="flex items-center text-sm font-semibold text-gray-800 mb-2">
                        <svg class="w-4 h-4 mr-2 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
                        Categoría
                    </label>
                    {{ form_widget(form.categoria, {
                        'attr': {
                            'class': 'mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm py-3 px-4 bg-gray-50 cursor-pointer transition-colors'
                        }
                    }) }}
                </div>

                <div>
                    <label class="flex items-center text-sm font-semibold text-gray-800 mb-2">
                        <svg class="w-4 h-4 mr-2 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
                        Descripción corta
                    </label>
                    {{ form_widget(form.descripcion, {
                        'attr': {
                            'class': 'mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm py-3 px-4 bg-gray-50 transition-colors',
                            'rows': '4',
                            'placeholder': '¿Qué temas vais a tratar en esta sesión? ¿Se necesita haber leído algo antes?'
                        }
                    }) }}
                </div>

                <div class="pt-6 border-t border-gray-100 flex items-center justify-end gap-4 mt-8">
                    <a href="{{ path('app_home') }}" class="text-gray-500 hover:text-gray-900 font-semibold text-sm transition-colors px-4 py-2">
                        Cancelar
                    </a>
                    <button type="submit" class="inline-flex items-center bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-6 rounded-xl transition-all shadow-lg hover:shadow-emerald-500/30 transform hover:-translate-y-0.5">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                        Crear e Iniciar Sala
                    </button>
                </div>

                {{ form_end(form) }}
            </div>

            <div class="hidden lg:block w-2/5 bg-gradient-to-br from-emerald-50 to-teal-100 p-8 sm:p-10 border-l border-emerald-100 relative overflow-hidden">
                <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 rounded-full bg-emerald-200 opacity-40 blur-3xl"></div>
                <div class="absolute bottom-0 left-0 -ml-16 -mb-16 w-48 h-48 rounded-full bg-teal-200 opacity-40 blur-3xl"></div>

                <div class="relative z-10 h-full flex flex-col">
                    <h3 class="text-xl font-bold text-emerald-900 mb-6 flex items-center">
                        <span class="bg-white p-2 rounded-lg shadow-sm mr-3">💡</span>
                        Consejos para tu sala
                    </h3>

                    <ul class="space-y-5 flex-1">
                        <li class="flex items-start">
                            <div class="flex-shrink-0 w-7 h-7 rounded-full bg-emerald-600 flex items-center justify-center text-white font-bold text-xs mt-0.5 shadow-md">1</div>
                            <p class="ml-3 text-sm text-emerald-800 leading-relaxed">Usa un título específico. <strong class="text-emerald-900">"Dudas Tema 4"</strong> funciona mucho mejor para atraer compañeros que un simple "Ayuda".</p>
                        </li>
                        <li class="flex items-start">
                            <div class="flex-shrink-0 w-7 h-7 rounded-full bg-emerald-600 flex items-center justify-center text-white font-bold text-xs mt-0.5 shadow-md">2</div>
                            <p class="ml-3 text-sm text-emerald-800 leading-relaxed">Deja claro en la descripción si vais a repasar teoría o a hacer ejercicios prácticos.</p>
                        </li>
                        <li class="flex items-start">
                            <div class="flex-shrink-0 w-7 h-7 rounded-full bg-emerald-600 flex items-center justify-center text-white font-bold text-xs mt-0.5 shadow-md">3</div>
                            <p class="ml-3 text-sm text-emerald-800 leading-relaxed">Ten listos tus apuntes o capturas de pantalla antes de iniciar el directo.</p>
                        </li>
                    </ul>

                    <div class="mt-8 p-5 bg-white/70 backdrop-blur-md rounded-2xl border border-white/80 shadow-sm">
                        <h4 class="text-xs font-bold text-emerald-800 uppercase tracking-wider mb-2 flex items-center">
                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
                            Siguiente paso
                        </h4>
                        <p class="text-sm text-emerald-900 font-medium">Al crear la sala, obtendrás un enlace único que podrás compartir por WhatsApp o Discord para que tus amigos se unan al instante.</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
{% endblock %}
