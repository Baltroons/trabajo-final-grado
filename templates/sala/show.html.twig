{% extends 'base.html.twig' %}

{% block body %}
    {# --- ESTILOS PARA ANIMACIONES Y SCROLL --- #}
    <style>
        @keyframes slideInRight {
            0% { opacity: 0; transform: translateX(30px) scale(0.95); }
            100% { opacity: 1; transform: translateX(0) scale(1); }
        }
        @keyframes slideInLeft {
            0% { opacity: 0; transform: translateX(-30px) scale(0.95); }
            100% { opacity: 1; transform: translateX(0) scale(1); }
        }
        .animate-slide-in-right { animation: slideInRight 0.3s cubic-bezier(0.25, 1, 0.5, 1) forwards; }
        .animate-slide-in-left { animation: slideInLeft 0.3s cubic-bezier(0.25, 1, 0.5, 1) forwards; }

        /* Scrollbar estilizado para el chat */
        #muro-mensajes::-webkit-scrollbar { width: 6px; }
        #muro-mensajes::-webkit-scrollbar-track { background: transparent; }
        #muro-mensajes::-webkit-scrollbar-thumb { background-color: rgba(16, 185, 129, 0.3); border-radius: 10px; }
    </style>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

        {# --- ENCABEZADO HERO --- #}
        <div class="bg-gradient-to-r from-emerald-900 to-teal-800 rounded-3xl shadow-xl p-8 md:p-10 mb-8 text-white relative overflow-hidden">
            <div class="absolute top-0 right-0 -mr-20 -mt-20 w-72 h-72 rounded-full bg-white opacity-10 blur-3xl"></div>

            <div class="relative z-10 flex flex-col md:flex-row md:items-start justify-between gap-6">
                <div>
                    <a href="{{ path('app_home') }}" class="text-emerald-200 hover:text-white text-sm font-semibold flex items-center gap-1 mb-4 transition-colors w-fit">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                        Volver a las salas
                    </a>
                    <div class="flex items-center gap-3 mb-2">
                        <span class="px-3 py-1 bg-emerald-700/50 border border-emerald-500/30 text-emerald-100 text-xs font-bold rounded-lg uppercase tracking-wider backdrop-blur-sm">
                            {{ sala.categoria }}
                        </span>
                    </div>
                    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4">{{ sala.nombre }}</h1>
                    <p class="text-emerald-100 text-lg max-w-2xl leading-relaxed">
                        {{ sala.descripcion ?: 'Espacio de estudio colaborativo. Únete para participar en la conversación y compartir apuntes.' }}
                    </p>
                </div>

                {% if app.user == sala.creador %}
                    <div class="flex flex-shrink-0 gap-3">
                        <button onclick="openEditModal()" class="bg-white/10 hover:bg-white/20 border border-white/20 text-white px-5 py-2.5 rounded-xl font-semibold backdrop-blur-md transition-all flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                            Ajustes
                        </button>
                        <div class="bg-red-500/80 hover:bg-red-600 border border-red-400/50 rounded-xl overflow-hidden backdrop-blur-md transition-all">
                            {{ include('sala/_delete_form.html.twig') }}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        {# --- NAVEGACIÓN DE PESTAÑAS (TABS) --- #}
        <div class="flex space-x-1 bg-gray-200/50 p-1 rounded-2xl mb-8 w-full md:w-fit mx-auto md:mx-0">
            <button onclick="switchRoomTab('foro')" id="btn-foro" class="tab-btn flex-1 md:flex-none px-6 py-2.5 rounded-xl text-sm font-bold bg-white text-emerald-700 shadow-sm transition-all">
                💬 Foro y Chat
            </button>
            <button onclick="switchRoomTab('multimedia')" id="btn-multimedia" class="tab-btn flex-1 md:flex-none px-6 py-2.5 rounded-xl text-sm font-bold text-gray-500 hover:text-gray-700 hover:bg-gray-100 transition-all">
                📁 Archivos
            </button>
            <button onclick="switchRoomTab('info')" id="btn-info" class="tab-btn flex-1 md:flex-none px-6 py-2.5 rounded-xl text-sm font-bold text-gray-500 hover:text-gray-700 hover:bg-gray-100 transition-all">
                ℹ️ Detalles
            </button>
        </div>

        {# --- CONTENEDORES DE LAS VISTAS --- #}

        {# VISTA 1: FORO Y CHAT #}
        <div id="tab-foro" class="tab-content block animate-fade-in">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                <div class="lg:col-span-8 space-y-8">
                    <div class="bg-white rounded-3xl shadow-sm border border-gray-200 overflow-hidden flex flex-col h-[700px]">
                        <div class="p-5 border-b border-gray-100 bg-gray-50 flex items-center justify-between z-10 shadow-sm">
                            <h3 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                                <span class="relative flex h-3 w-3">
                                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                  <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
                                </span>
                                Chat en vivo
                            </h3>
                            <span class="text-xs font-bold text-emerald-600 bg-emerald-100 px-3 py-1.5 rounded-full" id="chat-counter">{{ mensajes|length }} mensajes</span>
                        </div>

                        {# CONTENEDOR DE MENSAJES RENOVADO #}
                        <div id="muro-mensajes" class="flex-1 overflow-y-auto p-6 space-y-5 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] bg-gray-50/50 scroll-smooth">
                            {% for m in mensajes %}
                                {% set isMe = app.user and m.autor.id == app.user.id %}

                                <div class="flex {{ isMe ? 'justify-end' : 'justify-start' }} w-full {{ isMe ? 'animate-slide-in-right' : 'animate-slide-in-left' }}">
                                    <div class="flex gap-3 max-w-[85%] md:max-w-[70%] {{ isMe ? 'flex-row-reverse' : 'flex-row' }}">

                                        {# Avatar pegado abajo #}
                                        <div class="w-8 h-8 rounded-full flex-shrink-0 flex items-center justify-center font-bold text-[10px] shadow-sm self-end {{ isMe ? 'bg-emerald-700 text-white' : 'bg-white border border-gray-200 text-gray-700' }}">
                                            {{ m.autor.username|first|upper }}
                                        </div>

                                        <div class="flex flex-col {{ isMe ? 'items-end' : 'items-start' }}">
                                            {# Nombre y hora #}
                                            <div class="flex items-center gap-2 mb-1 px-1">
                                                <span class="text-[10px] font-bold text-gray-500">{{ isMe ? 'Tú' : m.autor.username }}</span>
                                                <span class="text-[9px] text-gray-400">{{ m.fechaCreacion|date('H:i') }}</span>
                                            </div>

                                            {# Burbuja Adaptable #}
                                            <div class="w-fit px-4 py-2.5 rounded-2xl text-sm shadow-sm transition-all {{ isMe ? 'bg-emerald-600 text-white rounded-tr-none' : 'bg-white border border-gray-200 text-gray-800 rounded-tl-none' }}">

                                                {% if m.contenido %}
                                                    <p class="whitespace-pre-wrap break-words leading-relaxed">{{ m.contenido }}</p>
                                                {% endif %}

                                                {# Lógica de archivos #}
                                                {% if m.archivoUrl is defined and m.archivoUrl %}
                                                    {% set filename = m.archivoNombre|default('')|lower %}
                                                    {% set isImage = filename ends with '.jpg' or filename ends with '.jpeg' or filename ends with '.png' or filename ends with '.gif' or filename ends with '.webp' %}

                                                    <div class="mt-2 overflow-hidden rounded-lg {{ isMe ? 'bg-emerald-700/30' : 'bg-gray-100' }}">
                                                        {% if isImage %}
                                                            <a href="{{ m.archivoUrl }}" target="_blank" class="block group relative">
                                                                <img src="{{ m.archivoUrl }}" alt="Adjunto" class="max-w-full h-auto max-h-64 object-cover rounded-lg hover:opacity-90 transition-opacity">
                                                                <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity bg-black/20">
                                                                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0h-3"></path></svg>
                                                                </div>
                                                            </a>
                                                        {% else %}
                                                            <div class="flex items-center gap-3 p-3 min-w-[200px]">
                                                                <div class="p-2 rounded-lg {{ isMe ? 'bg-emerald-500' : 'bg-white shadow-sm border border-gray-200' }}">
                                                                    <svg class="w-6 h-6 {{ isMe ? 'text-white' : 'text-emerald-600' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                                                                </div>
                                                                <div class="flex-1 min-w-0">
                                                                    <p class="text-xs font-bold truncate {{ isMe ? 'text-white' : 'text-gray-800' }}">{{ m.archivoNombre|default('Documento') }}</p>
                                                                </div>
                                                                <a href="{{ m.archivoUrl }}" target="_blank" class="p-1.5 hover:bg-black/10 rounded-md transition-colors" title="Descargar">
                                                                    <svg class="w-4 h-4 {{ isMe ? 'text-white' : 'text-gray-500' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                                                                </a>
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% else %}
                                <div class="h-full flex flex-col items-center justify-center text-center opacity-50" id="empty-chat">
                                    <span class="text-4xl mb-3">💬</span>
                                    <p class="text-gray-500 font-medium">El chat está vacío.</p>
                                    <p class="text-xs text-gray-400">Sé el primero en saludar.</p>
                                </div>
                            {% endfor %}
                        </div>

                        {# ZONA DE ENVÍO DE MENSAJES (Mantenida igual pero pulida) #}
                        {% if app.user in sala.miembros or app.user == sala.creador %}
                            <div class="p-4 bg-white border-t border-gray-100 flex flex-col gap-2 relative z-10 shadow-[0_-10px_15px_-3px_rgba(0,0,0,0.05)]">

                                <div id="file-preview-container" class="hidden px-4 py-2 mx-12 bg-emerald-50 text-emerald-700 text-xs font-bold rounded-lg border border-emerald-200 items-center justify-between w-max max-w-xs shadow-sm">
                                    <div class="flex items-center gap-2 overflow-hidden">
                                        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
                                        <span id="file-name-preview" class="truncate">archivo.pdf</span>
                                    </div>
                                    <button type="button" onclick="clearFileAttachment()" class="ml-3 text-emerald-900 hover:text-red-500 bg-emerald-100 p-1 rounded-full">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                    </button>
                                </div>

                                {{ form_start(formMensaje, {'attr': {'class': 'flex items-center gap-3', 'id': 'chat-form', 'enctype': 'multipart/form-data'}}) }}

                                <button type="button" onclick="document.getElementById('chat_file').click()" class="relative bg-gray-100 text-gray-500 hover:bg-emerald-100 hover:text-emerald-600 transition-colors p-3 rounded-full shadow-inner" title="Adjuntar archivo">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
                                    <span id="file-indicator" class="hidden absolute top-0 right-0 w-3 h-3 bg-red-500 border-2 border-white rounded-full"></span>
                                </button>

                                <input type="file" name="archivo_adjunto" id="chat_file" class="hidden" onchange="handleFileSelect(this)">

                                <div class="flex-1">
                                    {{ form_widget(formMensaje.contenido, {'id': 'chat_input', 'attr': {'class': 'w-full bg-gray-100 border-transparent focus:border-emerald-500 focus:bg-white focus:ring-2 focus:ring-emerald-200 rounded-full px-6 py-3.5 text-sm transition-all', 'placeholder': 'Escribe tu mensaje...', 'autocomplete': 'off'}}) }}
                                </div>

                                <button type="submit" id="btn_enviar_chat" class="bg-emerald-600 hover:bg-emerald-700 text-white w-12 h-12 rounded-full flex items-center justify-center transition-transform hover:scale-105 shadow-md flex-shrink-0">
                                    <svg class="w-5 h-5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
                                </button>

                                {{ form_end(formMensaje) }}
                            </div>
                        {% else %}
                            <div class="p-6 bg-gray-100 text-center border-t border-gray-200">
                                <p class="text-gray-500 text-sm font-bold">Debes ser miembro de la sala para escribir en el chat.</p>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# Panel Lateral: Miembros (Intacto) #}
                <div class="lg:col-span-4 space-y-6">
                    {% if app.user == sala.creador %}
                        <div class="bg-gradient-to-br from-gray-900 to-gray-800 rounded-3xl p-6 text-white shadow-lg">
                            <span class="bg-yellow-400 text-yellow-900 text-[10px] font-black px-2.5 py-1 rounded-md mb-3 inline-block uppercase">Admin</span>
                            <h4 class="text-xl font-bold mb-4">Tú mandas aquí</h4>
                            <button onclick="openInviteModal()" class="w-full bg-white text-gray-900 py-2.5 rounded-xl text-sm font-bold hover:bg-gray-100 transition-colors">+ Invitar Estudiantes</button>
                        </div>
                    {% endif %}

                    <div class="bg-white rounded-3xl shadow-sm border border-gray-200 p-6">
                        <h3 class="font-bold text-gray-900 mb-6 flex justify-between border-b border-gray-100 pb-4">
                            <span>Estudiantes</span>
                            <span class="bg-emerald-100 text-emerald-700 px-2.5 py-1 rounded-lg text-xs font-bold">{{ sala.miembros|length + 1 }}</span>
                        </h3>
                        <div class="space-y-4 max-h-[450px] overflow-y-auto pr-2">
                            <div class="flex items-center justify-between p-2 rounded-xl bg-amber-50 border border-amber-100">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 bg-amber-200 text-amber-800 rounded-xl flex items-center justify-center font-bold shadow-sm">{{ sala.creador.username|first|upper }}</div>
                                    <span class="text-sm font-bold text-gray-900">{{ sala.creador.username }}</span>
                                </div>
                                <span class="text-amber-500" title="Creador">👑</span>
                            </div>

                            {% for m in sala.miembros %}
                                <div class="flex items-center justify-between group p-2 hover:bg-gray-50 rounded-xl transition-colors">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 bg-gray-200 text-gray-600 rounded-full flex items-center justify-center text-xs font-bold">{{ m.username|first|upper }}</div>
                                        <span class="text-sm text-gray-700 font-medium">{{ m.username }}</span>
                                    </div>
                                    {% if app.user == sala.creador %}
                                        <form action="{{ path('app_sala_expulsar', {'id': sala.id, 'user_id': m.id}) }}" method="POST" onsubmit="confirmarExpulsion(event, this, '{{ m.username }}');">
                                            <button type="submit" class="text-gray-300 hover:text-red-500 p-1 bg-white hover:bg-red-50 rounded-lg transition-all" title="Expulsar">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7a4 4 0 11-8 0 4 4 0 018 0zM9 14a6 6 0 00-6 6v1h12v-1a6 6 0 00-6-6zM21 12h-6"></path></svg>
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# VISTA 2: MULTIMEDIA (Intacto) #}
        <div id="tab-multimedia" class="tab-content hidden animate-fade-in">
            <div class="bg-white rounded-3xl shadow-sm border border-gray-200 p-8 min-h-[500px]">
                <h3 class="text-2xl font-bold text-gray-900 mb-2">Biblioteca Multimedia</h3>
                <p class="text-gray-500 mb-8 text-sm">Documentos y apuntes compartidos en el chat de esta sala.</p>

                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
                    {% set tieneArchivos = false %}
                    {% for m in mensajes %}
                        {% if m.archivoUrl is defined and m.archivoUrl %}
                            {% set tieneArchivos = true %}
                            {% set filename = m.archivoNombre|default('')|lower %}
                            {% set isImage = filename ends with '.jpg' or filename ends with '.jpeg' or filename ends with '.png' or filename ends with '.gif' or filename ends with '.webp' %}

                            <a href="{{ m.archivoUrl }}" target="_blank" class="group flex flex-col p-4 bg-gray-50 hover:bg-emerald-50 border border-gray-200 hover:border-emerald-300 rounded-2xl transition-all hover:shadow-md">
                                {% if isImage %}
                                    <div class="h-28 bg-gray-100 rounded-xl mb-3 overflow-hidden group-hover:shadow-inner transition-all border border-gray-200">
                                        <img src="{{ m.archivoUrl }}" alt="Miniatura" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                                    </div>
                                {% else %}
                                    <div class="h-28 bg-white rounded-xl mb-3 flex items-center justify-center border border-gray-100 group-hover:scale-105 transition-transform">
                                        <svg class="w-10 h-10 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd"></path></svg>
                                    </div>
                                {% endif %}
                                <h4 class="text-sm font-bold text-gray-800 truncate mb-1" title="{{ m.archivoNombre|default('Documento') }}">{{ m.archivoNombre|default('Documento') }}</h4>
                                <div class="flex justify-between items-center text-xs text-gray-500 mt-auto">
                                    <span class="truncate pr-2">Por {{ m.autor.username }}</span>
                                    <span>{{ m.fechaCreacion|date('d/m') }}</span>
                                </div>
                            </a>
                        {% endif %}
                    {% endfor %}

                    {% if not tieneArchivos %}
                        <div class="col-span-full flex flex-col items-center justify-center py-20 text-gray-400">
                            <svg class="w-16 h-16 mb-4 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 19a2 2 0 01-2-2V7a2 2 0 012-2h4l2 2h4a2 2 0 012 2v1M5 19h14a2 2 0 002-2v-5a2 2 0 00-2-2H9a2 2 0 00-2 2v5a2 2 0 01-2 2z"></path></svg>
                            <p class="font-medium text-lg text-gray-500">No hay archivos en esta sala</p>
                            <p class="text-sm">Envía un archivo a través del chat para que aparezca aquí.</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# VISTA 3: INFO (Intacto) #}
        <div id="tab-info" class="tab-content hidden animate-fade-in">
            <div class="bg-white rounded-3xl shadow-sm border border-gray-200 overflow-hidden max-w-5xl mx-auto">
                <div class="p-8 border-b border-gray-100">
                    <h3 class="text-2xl font-bold text-gray-900">Información de la Sala</h3>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-gray-100">
                    <div class="p-8">
                        <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center mb-4">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        </div>
                        <h4 class="text-xs uppercase font-bold text-gray-400 tracking-wider mb-2">Acerca de</h4>
                        <p class="text-gray-800 leading-relaxed text-sm">{{ sala.descripcion ?: 'Sin descripción detallada. Una sala para colaborar y aprender juntos.' }}</p>
                    </div>

                    <div class="p-8">
                        <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-2xl flex items-center justify-center mb-4">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                        </div>
                        <h4 class="text-xs uppercase font-bold text-gray-400 tracking-wider mb-2">Estadísticas</h4>
                        <ul class="space-y-3 text-sm text-gray-700">
                            <li class="flex justify-between"><span>Categoría:</span> <strong class="text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded">{{ sala.categoria }}</strong></li>
                            <li class="flex justify-between"><span>Participantes:</span> <strong>{{ sala.miembros|length + 1 }}</strong></li>
                            <li class="flex justify-between"><span>Mensajes:</span> <strong>{{ mensajes|length }}</strong></li>
                        </ul>
                    </div>

                    <div class="p-8">
                        <div class="w-12 h-12 bg-amber-100 text-amber-600 rounded-2xl flex items-center justify-center mb-4">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                        </div>
                        <h4 class="text-xs uppercase font-bold text-gray-400 tracking-wider mb-2">Administración</h4>
                        <div class="flex items-center gap-3 mt-4">
                            <div class="w-10 h-10 bg-gray-200 rounded-full flex items-center justify-center font-bold text-gray-600">{{ sala.creador.username|first|upper }}</div>
                            <div>
                                <p class="text-sm font-bold text-gray-900">{{ sala.creador.username }}</p>
                                <p class="text-xs text-gray-500">Creador de la sala</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    {# --- MODALES --- #}
    {% if formEdit is defined %}
        <div id="editModal" class="fixed inset-0 z-50 hidden bg-gray-900/70 backdrop-blur-sm flex items-center justify-center transition-opacity opacity-0">
            <div class="bg-white rounded-3xl shadow-2xl w-full max-w-lg mx-4 overflow-hidden transform scale-95 transition-all duration-300" id="editModalContent">
                <div class="bg-gradient-to-r from-emerald-700 to-teal-600 px-8 py-5 flex justify-between items-center text-white">
                    <h3 class="font-bold text-xl flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                        Ajustes de la Sala
                    </h3>
                    <button onclick="closeEditModal()" class="text-white/70 hover:text-white transition-colors bg-white/10 hover:bg-white/20 p-2 rounded-full">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>
                <div class="p-8">
                    {{ form_start(formEdit, {'attr': {'id': 'form_editar_sala_ajax', 'class': 'space-y-4'}}) }}
                    {{ form_widget(formEdit) }}
                    <div class="mt-8 pt-4 border-t border-gray-100 flex gap-3">
                        <button type="button" onclick="closeEditModal()" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold py-3 rounded-xl transition-colors">Cancelar</button>
                        <button type="submit" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-xl transition-colors shadow-md hover:shadow-lg">Guardar Cambios</button>
                    </div>
                    {{ form_end(formEdit) }}
                </div>
            </div>
        </div>
    {% endif %}

    <div id="inviteModal" class="fixed inset-0 z-50 hidden bg-gray-900/70 backdrop-blur-sm flex items-center justify-center transition-opacity opacity-0">
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-md mx-4 overflow-hidden transform scale-95 transition-all duration-300" id="inviteModalContent">
            <div class="px-6 py-4 border-b bg-gray-50 flex justify-between items-center">
                <h3 class="font-bold text-gray-900 text-lg flex items-center gap-2">
                    <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path></svg>
                    Invitar Estudiante
                </h3>
                <button onclick="closeInviteModal()" class="text-gray-400 hover:text-gray-700 bg-gray-100 hover:bg-gray-200 p-2 rounded-full transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
            <div class="p-6">
                <form action="{{ path('app_sala_invitar', {'id': sala.id}) }}" method="POST" id="form_invitar_ajax" class="space-y-4">
                    <input type="text" name="usuario_invitado" required class="w-full bg-gray-50 border border-gray-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 rounded-xl px-4 py-3 text-sm transition-all" placeholder="Escribe el Email o Username">
                    <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-xl transition-colors shadow-md">Enviar Invitación</button>
                </form>
                <div class="mt-6">
                    <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">O comparte este enlace</p>
                    <div class="flex bg-gray-50 border border-gray-200 rounded-xl p-1 focus-within:border-emerald-500 focus-within:ring-2 focus-within:ring-emerald-200 transition-all">
                        <input type="text" readonly value="{{ url('app_sala_join', {'id': sala.id}) }}" class="bg-transparent text-sm text-gray-600 w-full px-3 outline-none" id="inviteLink">
                        <button onclick="copyInviteLink()" class="bg-white hover:bg-gray-50 text-emerald-600 font-bold text-xs px-4 py-2 rounded-lg border border-gray-200 shadow-sm transition-colors">Copiar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // --- 1. NAVEGACIÓN Y MODALES ---
        function switchRoomTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => { el.classList.remove('block'); el.classList.add('hidden'); });
            document.querySelectorAll('.tab-btn').forEach(btn => { btn.classList.remove('bg-white', 'text-emerald-700', 'shadow-sm'); btn.classList.add('text-gray-500', 'hover:bg-gray-100'); });
            const selectedTab = document.getElementById('tab-' + tabId);
            if (selectedTab) { selectedTab.classList.remove('hidden'); selectedTab.classList.add('block'); }
            const activeBtn = document.getElementById('btn-' + tabId);
            if (activeBtn) { activeBtn.classList.remove('text-gray-500', 'hover:bg-gray-100'); activeBtn.classList.add('bg-white', 'text-emerald-700', 'shadow-sm'); }
            if(tabId === 'foro') scrollToBottom();
        }

        function openEditModal() { const m = document.getElementById('editModal'); if(m){ m.classList.remove('hidden'); setTimeout(() => { m.classList.remove('opacity-0'); document.getElementById('editModalContent').classList.remove('scale-95'); }, 10); } }
        function closeEditModal() { const m = document.getElementById('editModal'); if(m){ m.classList.add('opacity-0'); document.getElementById('editModalContent').classList.add('scale-95'); setTimeout(() => { m.classList.add('hidden'); }, 300); } }
        function openInviteModal() { const m = document.getElementById('inviteModal'); m.classList.remove('hidden'); setTimeout(() => { m.classList.remove('opacity-0'); document.getElementById('inviteModalContent').classList.remove('scale-95'); }, 10); }
        function closeInviteModal() { const m = document.getElementById('inviteModal'); m.classList.add('opacity-0'); document.getElementById('inviteModalContent').classList.add('scale-95'); setTimeout(() => { m.classList.add('hidden'); }, 300); }

        function copyInviteLink() {
            document.getElementById("inviteLink").select();
            document.execCommand("copy");
            Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Enlace copiado', showConfirmButton: false, timer: 1500 });
        }

        // --- 2. GESTIÓN DE ARCHIVOS ---
        function handleFileSelect(input) {
            const preview = document.getElementById('file-preview-container');
            const fileName = document.getElementById('file-name-preview');
            const indicator = document.getElementById('file-indicator');

            if (input.files && input.files[0]) {
                fileName.textContent = input.files[0].name;
                preview.classList.remove('hidden'); preview.classList.add('flex');
                indicator.classList.remove('hidden');
            }
        }

        function clearFileAttachment() {
            document.getElementById('chat_file').value = '';
            document.getElementById('file-preview-container').classList.add('hidden');
            document.getElementById('file-preview-container').classList.remove('flex');
            document.getElementById('file-indicator').classList.add('hidden');
        }

        function confirmarExpulsion(e, form, username) {
            e.preventDefault();
            Swal.fire({ title: '¿Expulsar estudiante?', text: `¿Estás seguro de sacar a ${username}?`, icon: 'warning', showCancelButton: true, confirmButtonColor: '#ef4444', confirmButtonText: 'Expulsar', customClass: { popup: 'rounded-3xl' } })
                .then(res => { if (res.isConfirmed) form.submit(); });
        }

        function scrollToBottom() {
            const muro = document.getElementById('muro-mensajes');
            if(muro) muro.scrollTop = muro.scrollHeight;
        }

        document.addEventListener('DOMContentLoaded', () => {
            scrollToBottom();

            const myUsername = "{{ app.user ? app.user.username : '' }}";
            const chatBox = document.getElementById('muro-mensajes');
            const emptyState = document.getElementById('empty-chat');

            // --- MERCURE: RECIBIR MENSAJES ---
            const url = new URL('http://localhost:3000/.well-known/mercure');
            url.searchParams.append('topic', 'https://brainhub.com/sala/{{ sala.id }}');

            const eventSource = new EventSource(url);

            eventSource.onmessage = event => {
                const data = JSON.parse(event.data);
                if(emptyState) emptyState.remove();

                const isMe = data.autor === myUsername;
                const initialChar = data.autor.charAt(0).toUpperCase();

                // LÓGICA DE MINIATURAS JS Sincronizada con el HTML adaptativo
                let archivoHtml = '';
                if(data.archivoUrl) {
                    const ext = (data.archivoNombre || data.archivoUrl || '').split('.').pop().toLowerCase();
                    const isImage = ['jpg', 'jpeg', 'png', 'gif', 'webp'].includes(ext);

                    if(isImage) {
                        archivoHtml = `
                            <div class="mt-2 overflow-hidden rounded-lg ${isMe ? 'bg-emerald-700/30' : 'bg-gray-100'}">
                                <a href="${data.archivoUrl}" target="_blank" class="block group relative">
                                    <img src="${data.archivoUrl}" alt="Adjunto" class="max-w-full h-auto max-h-64 object-cover rounded-lg hover:opacity-90 transition-opacity">
                                    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity bg-black/20">
                                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0h-3"></path></svg>
                                    </div>
                                </a>
                            </div>`;
                    } else {
                        archivoHtml = `
                            <div class="mt-2 flex items-center gap-3 p-3 min-w-[200px]">
                                <div class="p-2 rounded-lg ${isMe ? 'bg-emerald-500' : 'bg-white shadow-sm border border-gray-200'}">
                                    <svg class="w-6 h-6 ${isMe ? 'text-white' : 'text-emerald-600'}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-xs font-bold truncate ${isMe ? 'text-white' : 'text-gray-800'}">${data.archivoNombre || 'Documento'}</p>
                                </div>
                                <a href="${data.archivoUrl}" target="_blank" class="p-1.5 hover:bg-black/10 rounded-md transition-colors">
                                    <svg class="w-4 h-4 ${isMe ? 'text-white' : 'text-gray-500'}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                                </a>
                            </div>`;
                    }
                }

                // Generación de la burbuja completa con animaciones
                const textHtml = data.contenido ? `<p class="whitespace-pre-wrap break-words leading-relaxed">${data.contenido}</p>` : '';
                const timeStr = data.fecha || new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});

                const animClass = isMe ? 'animate-slide-in-right' : 'animate-slide-in-left';
                const flexJustify = isMe ? 'justify-end' : 'justify-start';
                const flexRow = isMe ? 'flex-row-reverse' : 'flex-row';
                const avatarColor = isMe ? 'bg-emerald-700 text-white' : 'bg-white border border-gray-200 text-gray-700';
                const alignItems = isMe ? 'items-end' : 'items-start';
                const nameLabel = isMe ? 'Tú' : data.autor;
                const bubbleStyle = isMe ? 'bg-emerald-600 text-white rounded-tr-none' : 'bg-white border border-gray-200 text-gray-800 rounded-tl-none';

                const nuevoMensajeHtml = `
                    <div class="flex ${flexJustify} w-full ${animClass}">
                        <div class="flex gap-3 max-w-[85%] md:max-w-[70%] ${flexRow}">
                            <div class="w-8 h-8 rounded-full flex-shrink-0 flex items-center justify-center font-bold text-[10px] shadow-sm self-end ${avatarColor}">
                                ${initialChar}
                            </div>
                            <div class="flex flex-col ${alignItems}">
                                <div class="flex items-center gap-2 mb-1 px-1">
                                    <span class="text-[10px] font-bold text-gray-500">${nameLabel}</span>
                                    <span class="text-[9px] text-gray-400">${timeStr}</span>
                                </div>
                                <div class="w-fit px-4 py-2.5 rounded-2xl text-sm shadow-sm transition-all ${bubbleStyle}">
                                    ${textHtml}
                                    ${archivoHtml}
                                </div>
                            </div>
                        </div>
                    </div>`;

                chatBox.insertAdjacentHTML('beforeend', nuevoMensajeHtml);
                scrollToBottom();

                const counter = document.getElementById('chat-counter');
                if(counter) counter.innerText = parseInt(counter.innerText) + 1 + " mensajes";
                if (data.archivoUrl) {
                    const multimediaGrid = document.querySelector('#tab-multimedia .grid');
                    if (multimediaGrid) {
                        // Quitar el mensaje de "No hay archivos" si es el primero
                        const emptyStateMultimedia = multimediaGrid.querySelector('.col-span-full');
                        if (emptyStateMultimedia) emptyStateMultimedia.remove();

                        const isImageFile = ['jpg', 'jpeg', 'png', 'gif', 'webp'].includes((data.archivoNombre || data.archivoUrl).split('.').pop().toLowerCase());

                        // Generar la miniatura o el icono
                        const thumbHtml = isImageFile
                            ? `<div class="h-28 bg-gray-100 rounded-xl mb-3 overflow-hidden group-hover:shadow-inner transition-all border border-gray-200">
                                   <img src="${data.archivoUrl}" alt="Miniatura" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                               </div>`
                            : `<div class="h-28 bg-white rounded-xl mb-3 flex items-center justify-center border border-gray-100 group-hover:scale-105 transition-transform">
                                   <svg class="w-10 h-10 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd"></path></svg>
                               </div>`;

                        // Crear la tarjeta y añadirla al principio
                        const nuevaTarjetaHtml = `
                            <a href="${data.archivoUrl}" target="_blank" class="group flex flex-col p-4 bg-emerald-50 border border-emerald-300 rounded-2xl transition-all shadow-md animate-slide-in-right">
                                ${thumbHtml}
                                <h4 class="text-sm font-bold text-gray-800 truncate mb-1" title="${data.archivoNombre || 'Documento'}">${data.archivoNombre || 'Documento'}</h4>
                                <div class="flex justify-between items-center text-xs text-gray-500 mt-auto">
                                    <span class="truncate pr-2">Por ${data.autor}</span>
                                    <span>Recién subido</span>
                                </div>
                            </a>`;

                        multimediaGrid.insertAdjacentHTML('afterbegin', nuevaTarjetaHtml);
                    }
                }

            };

            // --- AJAX PARA ENVIAR CHAT ---
            const btnEnviarChat = document.getElementById('btn_enviar_chat');
            const chatInput = document.getElementById('chat_input');
            const chatFile = document.getElementById('chat_file');

            if (btnEnviarChat && chatInput) {
                const enviarMensaje = (e) => {
                    if (e) e.preventDefault();
                    const text = chatInput.value.trim();
                    const files = chatFile ? chatFile.files : [];

                    if (!text && files.length === 0) return;

                    const btnIcon = btnEnviarChat.innerHTML;
                    btnEnviarChat.innerHTML = '<svg class="animate-spin w-5 h-5 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';
                    btnEnviarChat.disabled = true;

                    const formData = new FormData();
                    formData.append('mensaje', text);
                    formData.append('salaId', '{{ sala.id }}');
                    if (files.length > 0) formData.append('archivo_adjunto', files[0]);

                    chatInput.value = '';
                    if (chatFile) clearFileAttachment();

                    fetch('/chat/enviar', { method: 'POST', body: formData })
                        .then(res => res.json())
                        .then(data => {
                            btnEnviarChat.innerHTML = btnIcon;
                            btnEnviarChat.disabled = false;
                            chatInput.focus();
                            if(data.error) Swal.fire('Error al enviar', data.error, 'error');
                        })
                        .catch(() => {
                            btnEnviarChat.innerHTML = btnIcon;
                            btnEnviarChat.disabled = false;
                            Swal.fire('Error', 'Fallo de conexión.', 'error');
                        });
                };

                btnEnviarChat.addEventListener('click', enviarMensaje);
                chatInput.addEventListener('keypress', (e) => {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        enviarMensaje();
                    }
                });
            }

            // AJAX Modal Edición
            const editForm = document.getElementById('form_editar_sala_ajax');
            if (editForm) {
                editForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    Swal.fire({ title: 'Guardando...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
                    fetch(this.action, { method: 'POST', body: new FormData(this), headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                        .then(res => res.json())
                        .then(data => {
                            if (data.status === 'success') {
                                closeEditModal();
                                Swal.fire({ icon: 'success', title: '¡Hecho!', showConfirmButton: false, timer: 1500, customClass: { popup: 'rounded-3xl' } }).then(() => location.reload());
                            } else { Swal.fire('Error', data.message || 'Error', 'error'); }
                        });
                });
            }
        });
    </script>
{% endblock %}
