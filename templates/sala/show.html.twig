{% extends 'base.html.twig' %}

{% block title %}Sala: {{ sala.nombre }} — BrainHub{% endblock %}

{% block body %}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

        {# --- ENCABEZADO HERO --- #}
        <div class="bg-gradient-to-r from-emerald-900 to-teal-800 rounded-3xl shadow-xl p-8 md:p-10 mb-8 text-white relative overflow-hidden">
            <div class="absolute top-0 right-0 -mr-20 -mt-20 w-72 h-72 rounded-full bg-white opacity-10 blur-3xl"></div>

            <div class="relative z-10 flex flex-col md:flex-row md:items-start justify-between gap-6">
                <div>
                    <a href="{{ path('app_home') }}" class="text-emerald-200 hover:text-white text-sm font-semibold flex items-center gap-1 mb-4 transition-colors w-fit">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                        Volver a las salas
                    </a>
                    <div class="flex items-center gap-3 mb-2">
                        <span class="px-3 py-1 bg-emerald-700/50 border border-emerald-500/30 text-emerald-100 text-xs font-bold rounded-lg uppercase tracking-wider backdrop-blur-sm">
                            {{ sala.categoria }}
                        </span>
                    </div>
                    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4">{{ sala.nombre }}</h1>
                    <p class="text-emerald-100 text-lg max-w-2xl leading-relaxed">
                        {{ sala.descripcion ?: 'Espacio de estudio colaborativo. Únete para participar en la conversación y compartir apuntes.' }}
                    </p>
                </div>

                {% if app.user == sala.creador %}
                    <div class="flex flex-shrink-0 gap-3">
                        <a href="{{ path('app_sala_edit', {'id': sala.id}) }}" class="bg-white/10 hover:bg-white/20 border border-white/20 text-white px-5 py-2.5 rounded-xl font-semibold backdrop-blur-md transition-all flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                            Ajustes
                        </a>
                        <div class="bg-red-500/80 hover:bg-red-600 border border-red-400/50 rounded-xl overflow-hidden backdrop-blur-md transition-all">
                            {{ include('sala/_delete_form.html.twig') }}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        {# --- NAVEGACIÓN DE PESTAÑAS (TABS) --- #}
        <div class="flex space-x-1 bg-gray-200/50 p-1 rounded-2xl mb-8 w-full md:w-fit mx-auto md:mx-0">
            <button onclick="switchTab('foro')" id="btn-foro" class="tab-btn flex-1 md:flex-none px-6 py-2.5 rounded-xl text-sm font-bold bg-white text-emerald-700 shadow-sm transition-all">
                💬 Foro y Chat
            </button>
            <button onclick="switchTab('multimedia')" id="btn-multimedia" class="tab-btn flex-1 md:flex-none px-6 py-2.5 rounded-xl text-sm font-bold text-gray-500 hover:text-gray-700 hover:bg-gray-100 transition-all">
                📁 Multimedia
            </button>
            <button onclick="switchTab('info')" id="btn-info" class="tab-btn flex-1 md:flex-none px-6 py-2.5 rounded-xl text-sm font-bold text-gray-500 hover:text-gray-700 hover:bg-gray-100 transition-all">
                ℹ️ Información
            </button>
        </div>

        {# --- CONTENEDORES DE LAS VISTAS --- #}

        {# VISTA 1: FORO Y CHAT #}
        <div id="tab-foro" class="tab-content block animate-fade-in">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

                {# Chat Principal #}
                <div class="lg:col-span-8 space-y-8">
                    <div class="bg-white rounded-3xl shadow-sm border border-gray-200 overflow-hidden flex flex-col h-[650px]">
                        <div class="p-5 border-b border-gray-100 bg-gray-50 flex items-center justify-between">
                            <h3 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                                <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                                Foro General
                            </h3>
                            <span class="text-xs font-bold text-emerald-600 bg-emerald-100 px-2 py-1 rounded-full">{{ mensajes|length }} mensajes</span>
                        </div>

                        {# Muro de mensajes #}
                        <div class="flex-1 overflow-y-auto p-6 space-y-6 bg-gray-50/50">
                            {% for m in mensajes %}
                                {% set isMe = app.user and m.autor.id == app.user.id %}
                                <div class="flex gap-4 {{ isMe ? 'flex-row-reverse' : '' }}">
                                    <div class="w-10 h-10 rounded-full flex-shrink-0 flex items-center justify-center font-bold text-sm shadow-sm {{ isMe ? 'bg-emerald-600 text-white' : 'bg-white border border-gray-200 text-gray-700' }}">
                                        {{ m.autor.username|first|upper }}
                                    </div>
                                    <div class="flex flex-col {{ isMe ? 'items-end' : 'items-start' }} max-w-[80%]">
                                        <div class="flex items-center gap-2 mb-1">
                                            <span class="text-xs font-bold text-gray-500">{{ isMe ? 'Tú' : m.autor.username }}</span>
                                            <span class="text-[10px] text-gray-400">{{ m.fechaCreacion|date('H:i') }}</span>
                                        </div>
                                        <div class="p-4 rounded-2xl text-sm shadow-sm whitespace-pre-wrap {{ isMe ? 'bg-emerald-600 text-white rounded-tr-none' : 'bg-white border border-gray-100 text-gray-700 rounded-tl-none' }}">{{ m.contenido }}</div>
                                    </div>
                                </div>
                            {% else %}
                                <div class="h-full flex flex-col items-center justify-center text-center opacity-50">
                                    <span class="text-4xl mb-3">👋</span>
                                    <p class="text-gray-500 font-medium">Foro vacío.</p>
                                    <p class="text-xs text-gray-400">Sé el primero en aportar a la clase.</p>
                                </div>
                            {% endfor %}
                        </div>

                        {# Formulario de chat con Multimedia #}
                        {% if app.user in sala.miembros or app.user == sala.creador %}
                            <div class="p-4 bg-white border-t border-gray-100 flex flex-col gap-2">

                                {# Etiqueta para previsualizar el nombre del archivo adjunto #}
                                <div id="file-preview-container" class="hidden px-4 py-2 mx-12 bg-emerald-50 text-emerald-700 text-xs font-bold rounded-lg border border-emerald-200 flex items-center justify-between w-max max-w-xs">
                                    <span id="file-name-preview" class="truncate">archivo.pdf</span>
                                    <button type="button" onclick="clearFileAttachment()" class="ml-2 text-emerald-900 hover:text-red-500">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                    </button>
                                </div>

                                {{ form_start(formMensaje, {'attr': {'class': 'flex items-center gap-3', 'enctype': 'multipart/form-data'}}) }}

                                {# Botón que abre el input file oculto #}
                                <button type="button" onclick="document.getElementById('archivo_adjunto').click()" class="relative text-gray-400 hover:text-emerald-600 transition-colors p-2" title="Adjuntar archivo">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
                                    <span id="file-indicator" class="hidden absolute top-1 right-1 w-2.5 h-2.5 bg-red-500 border-2 border-white rounded-full"></span>
                                </button>

                                {# Input file real de HTML (oculto) #}
                                <input type="file" name="archivo_adjunto" id="archivo_adjunto" class="hidden" onchange="handleFileSelect(this)">

                                <div class="flex-1">
                                    {{ form_widget(formMensaje.contenido, {
                                        'attr': {
                                            'class': 'w-full bg-gray-100 border-transparent focus:border-emerald-500 focus:bg-white focus:ring-0 rounded-full px-6 py-3 text-sm transition-all',
                                            'placeholder': 'Escribe algo o adjunta un archivo...'
                                        }
                                    }) }}
                                </div>
                                <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white w-12 h-12 rounded-full flex items-center justify-center transition-transform hover:scale-105 shadow-md flex-shrink-0">
                                    <svg class="w-5 h-5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
                                </button>
                                {{ form_end(formMensaje) }}
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# Panel Lateral (Roles y Gestión de Miembros) #}
                <div class="lg:col-span-4 space-y-6">
                    {% if app.user == sala.creador %}
                        <div class="bg-gradient-to-br from-gray-900 to-gray-800 rounded-3xl p-6 text-white shadow-lg relative">
                            <span class="bg-yellow-400 text-yellow-900 text-[10px] font-black px-2.5 py-1 rounded-md mb-3 inline-block uppercase tracking-widest">Admin</span>
                            <h4 class="text-xl font-bold mb-1">Tú mandas aquí</h4>
                            <p class="text-gray-400 text-sm mb-4">Gestiona a los miembros desde la lista inferior.</p>

                            <button onclick="openInviteModal()" class="w-full bg-white text-gray-900 py-2.5 rounded-xl text-sm font-bold shadow-md hover:bg-gray-100 transition-colors mb-2">
                                + Invitar Estudiantes
                            </button>
                        </div>
                    {% elseif app.user in sala.miembros %}
                        <div class="bg-emerald-50 rounded-3xl p-6 border border-emerald-200">
                            <div class="flex items-center gap-3 text-emerald-700 font-bold text-sm mb-3">
                                <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
                                Miembro activo
                            </div>
                            <p class="text-emerald-800/80 text-sm">Tienes acceso total al chat y a la biblioteca multimedia.</p>
                        </div>
                    {% else %}
                        <div class="bg-gradient-to-b from-white to-gray-50 rounded-3xl p-6 border border-gray-200 shadow-sm text-center">
                            <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-4">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path></svg>
                            </div>
                            <h4 class="font-bold text-gray-900 mb-2">Únete a la clase</h4>
                            <p class="text-sm text-gray-500 mb-6">Participa en el chat y descarga los materiales de estudio.</p>
                            <form action="{{ path('app_sala_join', {'id': sala.id}) }}" method="POST">
                                <button class="w-full bg-emerald-600 hover:bg-emerald-700 text-white py-3.5 rounded-xl font-bold shadow-lg shadow-emerald-600/30 transition-all hover:-translate-y-0.5">
                                    Unirme a la Sala
                                </button>
                            </form>
                        </div>
                    {% endif %}

                    {# Lista de Estudiantes #}
                    <div class="bg-white rounded-3xl shadow-sm border border-gray-200 p-6">
                        <h3 class="font-bold text-gray-900 mb-6 flex items-center justify-between border-b border-gray-100 pb-4">
                            <span>Estudiantes</span>
                            <span class="bg-emerald-100 text-emerald-700 px-2.5 py-1 rounded-lg text-xs font-bold">{{ sala.miembros|length + 1 }}</span>
                        </h3>

                        <div class="space-y-4 max-h-[400px] overflow-y-auto pr-2">
                            {# Creador #}
                            <div class="flex items-center justify-between group">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 bg-amber-100 text-amber-700 rounded-xl flex items-center justify-center text-sm font-bold shadow-sm">
                                        {{ sala.creador.username|first|upper }}
                                    </div>
                                    <div>
                                        <span class="block text-sm font-bold text-gray-900">{{ sala.creador.username }}</span>
                                        <span class="text-[10px] text-gray-500 font-medium">Anfitrión</span>
                                    </div>
                                </div>
                                <span class="text-amber-500" title="Propietario">
                                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                                </span>
                            </div>

                            {# Miembros #}
                            {% for miembro in sala.miembros %}
                                <div class="flex items-center justify-between group hover:bg-gray-50 p-2 -mx-2 rounded-xl transition-colors">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 bg-gray-100 text-gray-600 rounded-full flex items-center justify-center text-xs font-bold">
                                            {{ miembro.username|first|upper }}
                                        </div>
                                        <span class="text-sm font-semibold text-gray-700">{{ miembro.username }}</span>
                                    </div>

                                    {% if app.user == sala.creador %}
                                        {# Formulario para expulsar usuario (Ruta pendiente de crear en tu controlador) #}
                                        <form action="{{ path('app_sala_expulsar', {'id': sala.id, 'user_id': miembro.id}) }}" method="POST" class="inline" onsubmit="return confirm('¿Estás seguro de que quieres expulsar a este estudiante?');">
                                            <button type="submit" class="text-gray-300 hover:text-red-500 transition-colors p-1" title="Expulsar de la sala">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7a4 4 0 11-8 0 4 4 0 018 0zM9 14a6 6 0 00-6 6v1h12v-1a6 6 0 00-6-6zM21 12h-6"></path></svg>
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# VISTA 2: MULTIMEDIA Y ARCHIVOS #}
        <div id="tab-multimedia" class="tab-content hidden animate-fade-in">
            <div class="bg-white rounded-3xl shadow-sm border border-gray-200 p-8 min-h-[500px]">

                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-8 gap-4">
                    <div>
                        <h3 class="text-2xl font-bold text-gray-900">Biblioteca Multimedia</h3>
                        <p class="text-gray-500 text-sm mt-1">Todos los archivos y apuntes compartidos a lo largo del tiempo.</p>
                    </div>

                    {% if app.user in sala.miembros or app.user == sala.creador %}
                        <div class="bg-emerald-50 rounded-2xl p-2 w-full sm:w-auto">
                            {{ form_start(formArchivo, {'attr': {'class': 'flex items-center gap-2'}}) }}
                            {{ form_widget(formArchivo.documento, {
                                'attr': {'class': 'block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-white file:text-emerald-700 file:cursor-pointer'}
                            }) }}
                            <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-xl text-sm font-bold whitespace-nowrap shadow-sm">Subir</button>
                            {{ form_end(formArchivo) }}
                        </div>
                    {% endif %}
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    {% for archivo in sala.archivos %}
                        <div class="flex flex-col p-5 bg-gray-50 hover:bg-emerald-50 border border-gray-200 hover:border-emerald-200 rounded-2xl transition-all group">
                            <div class="flex justify-between items-start mb-4">
                                <div class="p-3 bg-white shadow-sm text-emerald-600 rounded-xl">
                                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd"></path></svg>
                                </div>
                                <a href="{{ asset('uploads/' ~ archivo.nombreServidor) }}" target="_blank" class="text-xs font-bold text-emerald-700 bg-emerald-100/50 hover:bg-emerald-200 px-3 py-1.5 rounded-lg transition-colors">Descargar</a>
                            </div>
                            <h4 class="text-sm font-bold text-gray-800 truncate mb-1" title="{{ archivo.nombreOriginal }}">{{ archivo.nombreOriginal }}</h4>
                            <div class="flex justify-between items-center text-[11px] text-gray-500 mt-auto">
                                <span>Por {{ archivo.subidoPor.username }}</span>
                            </div>
                        </div>
                    {% else %}
                        <div class="col-span-full border-2 border-dashed border-gray-200 rounded-2xl p-12 text-center bg-gray-50">
                            <p class="text-gray-500 font-medium">Aún no hay apuntes en esta sala.</p>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        {# VISTA 3: INFORMACIÓN #}
        <div id="tab-info" class="tab-content hidden animate-fade-in">
            <div class="bg-white rounded-3xl shadow-sm border border-gray-200 p-8 min-h-[500px] max-w-4xl mx-auto">
                <h3 class="text-2xl font-bold text-gray-900 mb-6 border-b border-gray-100 pb-4">Detalles del Espacio de Estudio</h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div>
                        <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Descripción General</h4>
                        <p class="text-gray-700 leading-relaxed">{{ sala.descripcion ?: 'Sin descripción detallada proporcionada por el creador.' }}</p>

                        <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2 mt-6">Reglas de la Sala</h4>
                        <ul class="list-disc list-inside text-gray-700 space-y-1 text-sm">
                            <li>Respeto mutuo en el foro.</li>
                            <li>No compartir contenido con copyright comercial.</li>
                            <li>Mantener el enfoque en {{ sala.categoria }}.</li>
                        </ul>
                    </div>

                    <div class="bg-gray-50 p-6 rounded-2xl border border-gray-100">
                        <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">Estadísticas</h4>
                        <div class="space-y-4">
                            <div class="flex justify-between items-center border-b border-gray-200 pb-2">
                                <span class="text-sm text-gray-600">Creado por</span>
                                <span class="text-sm font-bold text-gray-900">{{ sala.creador.username }}</span>
                            </div>
                            <div class="flex justify-between items-center border-b border-gray-200 pb-2">
                                <span class="text-sm text-gray-600">Categoría</span>
                                <span class="text-sm font-bold bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded">{{ sala.categoria }}</span>
                            </div>
                            <div class="flex justify-between items-center border-b border-gray-200 pb-2">
                                <span class="text-sm text-gray-600">Total Estudiantes</span>
                                <span class="text-sm font-bold text-gray-900">{{ sala.miembros|length + 1 }}</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-sm text-gray-600">Archivos compartidos</span>
                                <span class="text-sm font-bold text-gray-900">{{ sala.archivos|length }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    {# --- MODAL DE INVITACIÓN --- #}
    <div id="inviteModal" class="fixed inset-0 z-50 hidden bg-gray-900/60 backdrop-blur-sm flex items-center justify-center transition-opacity opacity-0">
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-md mx-4 overflow-hidden transform scale-95 transition-transform" id="inviteModalContent">
            <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
                <h3 class="font-bold text-gray-900 text-lg">Invitar a un estudiante</h3>
                <button onclick="closeInviteModal()" class="text-gray-400 hover:text-gray-700 transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
            <div class="p-6">
                <form action="{{ path('app_sala_invitar', {'id': sala.id}) }}" method="POST" class="space-y-4">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Nombre de usuario o Email</label>
                        <input type="text" name="usuario_invitado" required class="w-full bg-gray-50 border border-gray-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 rounded-xl px-4 py-3 text-sm transition-all" placeholder="ejemplo@correo.com">
                    </div>
                    <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-xl transition-colors shadow-md">
                        Enviar Invitación
                    </button>
                </form>

                <div class="mt-6 flex items-center">
                    <div class="flex-grow border-t border-gray-200"></div>
                    <span class="flex-shrink-0 mx-4 text-gray-400 text-xs font-bold uppercase">O comparte este enlace</span>
                    <div class="flex-grow border-t border-gray-200"></div>
                </div>

                <div class="mt-4 flex bg-gray-50 border border-gray-200 rounded-xl p-1">
                    <input type="text" readonly value="{{ url('app_sala_join', {'id': sala.id}) }}" class="bg-transparent text-xs text-gray-500 w-full px-3 outline-none" id="inviteLink">
                    <button onclick="copyInviteLink()" class="bg-white text-emerald-600 font-bold text-xs px-4 py-2 rounded-lg border border-gray-200 shadow-sm hover:bg-emerald-50 transition-colors">Copiar</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // --- 1. SCRIPT DE PESTAÑAS (TABS) ---
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => {
                el.classList.remove('block');
                el.classList.add('hidden');
            });

            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('bg-white', 'text-emerald-700', 'shadow-sm');
                btn.classList.add('text-gray-500', 'hover:bg-gray-100');
            });

            document.getElementById('tab-' + tabId).classList.remove('hidden');
            document.getElementById('tab-' + tabId).classList.add('block');

            const activeBtn = document.getElementById('btn-' + tabId);
            activeBtn.classList.remove('text-gray-500', 'hover:bg-gray-100');
            activeBtn.classList.add('bg-white', 'text-emerald-700', 'shadow-sm');
        }

        // --- 2. SCRIPT DE ARCHIVOS EN CHAT ---
        function handleFileSelect(input) {
            const indicator = document.getElementById('file-indicator');
            const previewContainer = document.getElementById('file-preview-container');
            const previewText = document.getElementById('file-name-preview');

            if (input.files && input.files.length > 0) {
                indicator.classList.remove('hidden');
                previewText.textContent = input.files[0].name;
                previewContainer.classList.remove('hidden');
            } else {
                clearFileAttachment();
            }
        }

        function clearFileAttachment() {
            const input = document.getElementById('archivo_adjunto');
            input.value = '';
            document.getElementById('file-indicator').classList.add('hidden');
            document.getElementById('file-preview-container').classList.add('hidden');
        }

        // --- 3. SCRIPT DEL MODAL DE INVITACIONES ---
        const modal = document.getElementById('inviteModal');
        const modalContent = document.getElementById('inviteModalContent');

        function openInviteModal() {
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modalContent.classList.remove('scale-95');
            }, 10);
        }

        function closeInviteModal() {
            modal.classList.add('opacity-0');
            modalContent.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }

        function copyInviteLink() {
            const copyText = document.getElementById("inviteLink");
            copyText.select();
            copyText.setSelectionRange(0, 99999);
            navigator.clipboard.writeText(copyText.value);

            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    toast: true, position: 'top-end', icon: 'success', title: 'Enlace copiado al portapapeles', showConfirmButton: false, timer: 3000
                });
            } else {
                alert("Enlace copiado al portapapeles");
            }
        }
    </script>
{% endblock %}
