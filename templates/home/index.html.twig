    <script>

        /* BRAINHUB EMERGENCY v10 - TIMER + METRICAS CORREGIDAS */
        (function(){
            try{
                /* ====== TIMER v2 - INDEPENDIENTE POR USUARIO  ====== */
                var s=0, el=null, iv=null;

                //  Obtener ID único del usuario desde Twig/PHP
                var USER_KEY = 'bh9_' + ({{ app.user.id ?? 'guest' }});

                function load(){
                    try{
                        var d = localStorage.getItem(USER_KEY); // Clave única por usuario
                        if(d){
                            var p = JSON.parse(d);
                            var a = Date.now() - p.t;
                            if(a < 86400000 && a > 0) s = p.s + Math.floor(a / 1000);
                        }
                    } catch(e){}
                }

                function save(){
                    try{
                        localStorage.setItem(USER_KEY, JSON.stringify({s: s, t: Date.now()})); // Guardar en clave única
                    } catch(e){}
                }
                function fmt(x){if(x<0)x=0;var h=Math.floor(x/3600),m=Math.floor((x%3600)/60),sec=x%60;if(h>0)return h+'h '+('0'+m).slice(-2)+'m';if(m>0)return m+'m '+('0'+sec).slice(-2)+'s';return sec+'s'}
                function upd(){
                    if(!el)return;

                    // Cambiar texto inmediatamente
                    el.textContent = fmt(s);

                    // Pulso de color suave (verde → normal)
                    el.style.transition = 'color 300ms ease';
                    el.style.color = '#00bc7d'; // emerald-500

                    // Volver al color original después de 300ms
                    setTimeout(function() {
                        el.style.color = '';
                    }, 300);
                }

                load();
                el=document.querySelector('[data-metric="tiempo"]');
                if(!el){var cards=document.querySelectorAll('.grid.grid-cols-1.md\\:grid-cols-4 > div');if(cards[1])el=cards[1].querySelector('.text-3xl')}
                //  if(!el){document.body.insertAdjacentHTML('beforeend','<div style="position:fixed;top:10px;right:10px;z-index:999999;background:#dc2626;color:#fff;padding:15px;border-radius:12px;font-family:system-ui;text-align:center;box-shadow:0 10px 30px rgba(0,0,0,.5)"><div style="font-size:10px;opacity:.8">TIEMPO</div><div id="bh9t" style="font-size:28px;font-weight:bold">0s</div></div>');el=document.getElementById('bh9t')}

                upd();

                //iv=setInterval(function(){s++;upd();if(s%10===0)save()},1000);
                setInterval(function(){s++;},1000);  // Contar segundos
                iv=setInterval(function(){upd();save()},60000);  // Actualizar cada min
                window.addEventListener('beforeunload',save);

                window.BrainHubTimer={time:function(){return fmt(s)},secs:function(){return s},reset:function(){s=0;save();upd()}};

                /* ====== METRICAS CORREGIDAS v2 ====== */

                // Estado global - se inicializará con valor REAL del servidor
                var state = {
                    mensajes: 0,      // Se cargará del servidor
                    salas: 0,         // Se cargará del servidor
                    loadedFromServer: false  // ¿Ya cargamos del servidor?
                };

                /* Actualizar elemento DOM con animación */
                function updateElement(selector, newValue) {
                    var e = document.querySelector(selector);
                    if (!e) return false;

                    var ov = parseInt(e.textContent) || 0;
                    if (ov === newValue) return true;

                    e.textContent = newValue;
                    e.style.transition = 'all 300ms cubic-bezier(0.34, 1.56, 0.64, 1)';
                    e.style.transform = 'scale(1.3)';
                    e.style.color = '#10b981';

                    setTimeout(function() {
                        e.style.transform = 'scale(1)';
                        e.style.color = '';
                    }, 400);
                    return true;
                }

                /* Cargar métricas del servidor (se usa al inicio y cada 15s) */
                async function loadMetricsFromServer() {
                    try {
                        var response = await fetch('/api/dashboard/metrics', {
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });

                        if (response.ok) {
                            var result = await response.json();

                            if (result.success && result.data) {
                                var data = result.data;

                                // Sincronizar MENSAJES
                                if (typeof data.mensajes_hoy === 'number') {
                                    // Si es la primera carga, usar valor del servidor como base
                                    if (!state.loadedFromServer) {
                                        state.mensajes = data.mensajes_hoy;
                                    } else {
                                        // Si ya estamos corriendo, solo actualizar si el servidor tiene más
                                        if (data.mensajes_hoy > state.mensajes) {
                                            state.mensajes = data.mensajes_hoy;
                                        }
                                    }

                                    updateElement('[data-metric="mensajes"]', state.mensajes);
                                }

                                // Sincronizar SALAS
                                if (typeof data.salas_activas_hoy === 'number') {
                                    state.salas = data.salas_activas_hoy;

                                    var cards = document.querySelectorAll('.grid.grid-cols-1.md\\:grid-cols-4 > div');
                                    if (cards[0]) {
                                        var salasEl = cards[0].querySelector('.text-3xl');
                                        if (salasEl) salasEl.textContent = state.salas;
                                    }
                                }

                                // Marcar como cargado
                                state.loadedFromServer = true;
                            }
                        }
                    } catch(err) {
                        console.warn('[SERVER] Error cargando métricas:', err);
                    }
                }

                /* ====== INTERCEPTOR DE MENSAJES (CORREGIDO) ====== */

                var origFetch = window.fetch;

                window.fetch = function() {
                    var args = arguments;
                    var url = args[0] + '';
                    var opt = args[1] || {};

                    // Detectar envío de mensaje
                    if (opt.method === 'POST' && url.indexOf('/chat/enviar') !== -1) {
                        var res = origFetch.apply(this, args);

                        res.then(function(r) {
                            if (r.ok) {
                                // Incrementar SOLO si ya tenemos valor base del servidor
                                if (state.loadedFromServer || state.mensajes > 0) {
                                    state.mensajes++;
                                } else {
                                    // Si aún no cargamos del servidor, asumir que había al menos el valor actual + 1
                                    state.mensajes = Math.max(state.mensajes, 0) + 1;
                                }

                                updateElement('[data-metric="mensajes"]', state.mensajes);
                            }
                        }).catch(function() {});

                        return res;
                    }

                    return origFetch.apply(this, args);
                };

                /* ====== INICIALIZACIÓN ====== */

                loadMetricsFromServer();

                // PASO 2: Polling cada 15s para mantener sincronizado
                setInterval(loadMetricsFromServer, 15000);

                // API Global
                window.BrainHubMetrics = {
                    inc: function() {
                        state.mensajes++;
                        updateElement('[data-metric="mensajes"]', state.mensajes);
                    },
                    get: function() { return state.mensajes; },
                    set: function(v) {
                        state.mensajes = v;
                        updateElement('[data-metric="mensajes"]', v);
                    },
                    refresh: function() { return loadMetricsFromServer(); },
                    getState: function() { return state; }
                };

            }catch(err){
                console.error('ERROR FATAL:',err);
            }
        })();
    </script>
