{% extends 'base.html.twig' %}

{% block title %}Dashboard — BrainHub{% endblock %}

{% block body %}
    {% if app.user %}
        {# =============================================================================
           DASHBOARD DE USUARIO (LOGUEADO) - CONTENIDO PRINCIPAL
           ============================================================================= #}
        <div class="p-6 md:p-10 transition-all duration-500">
            <div class="max-w-6xl mx-auto space-y-8">

                {# 1. BARRA SUPERIOR #}
                <div class="flex justify-between items-center gap-4">
                    <div class="relative w-full max-w-md">
                        <div class="absolute inset-y-0 left-0 pl-4   flex items-center text-gray-400 dark:text-gray-500">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                        </div>
                        <input type="text" id="live-search" placeholder="Buscar salas..."
                               class="block w-full pl-12 pr-4 py-3 border border-gray-100 dark:border-darkBorder bg-white dark:bg-darkCard dark:text-white rounded-full text-sm shadow-sm focus:ring-2 focus:ring-emerald-500 outline-none transition-all">
                    </div>

                    <div class="flex items-center gap-4">
                        <span class="hidden md:inline-block text-sm font-bold text-gray-700">
                            ¡Hola, <span class="text-emerald-700">{{ app.user.username }}</span>!
                        </span>
                    </div>
                </div>

                {# 2. BANNER HERO #}
                <div class="bg-[#065f46] rounded-[2.5rem] p-10 md:p-14 text-white relative overflow-hidden shadow-xl shadow-emerald-900/10">
                    <div class="relative z-10 max-w-xl">
                        <h1 class="text-4xl md:text-5xl font-black mb-4 leading-tight">¿Qué toca estudiar hoy?</h1>
                        <p class="text-emerald-100/80 text-lg mb-8">Únete a una sala activa o crea tu propio espacio de estudio colaborativo.</p>

                        <button onclick="window.openNuevaSalaModal()"
                                class="inline-block bg-white text-[#065f46] font-bold py-4 px-10 rounded-2xl hover:bg-emerald-50 transition-all transform hover:scale-105 shadow-lg shadow-black/10">
                            + Crear Sala de Estudio
                        </button>
                    </div>
                    <div class="absolute -right-20 -bottom-20 h-64 w-64 bg-white/10 rounded-full blur-3xl"></div>
                    <div class="absolute right-0 top-0 h-full w-1/3 bg-emerald-700/20 skew-x-12 translate-x-20"></div>
                </div>

                {# =====================================================================
                   DASHBOARD ANALÍTICO MEJORADO - CON DATOS PRE-FORMATEADOS
                   ===================================================================== #}
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6">

                    {# 1. SALAS ACTIVAS HOY #}
                    <div class="bg-white dark:bg-darkCard p-6 rounded-[2rem] shadow-sm border border-gray-100 dark:border-darkBorder transition-all hover:shadow-lg hover:-translate-y-1 group">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-14 h-14 bg-gradient-to-br from-emerald-400 to-emerald-600 text-white rounded-2xl flex items-center justify-center text-2xl shadow-lg shadow-emerald-500/30 group-hover:scale-110 transition-transform">
                                📚
                            </div>
                            {% if metricas.porcentaje_cambio_salas > 0 %}
                                <span class="flex items-center gap-1 text-xs font-bold text-emerald-600 bg-emerald-50 dark:bg-emerald-900/30 px-2 py-1 rounded-full">
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.293 9.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L11 7.414V15a1 1 0 11-2 0V7.414L6.707 9.707a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
                    +{{ metricas.porcentaje_cambio_salas }}%
                </span>
                            {% endif %}
                        </div>
                        <div>
                            <p class="text-gray-400 dark:text-gray-500 text-xs font-bold uppercase tracking-wider mb-1">Salas Activas</p>
                            <p class="text-3xl font-black text-gray-800 dark:text-white">{{ metricas.salas_activas_hoy|default(0) }}</p>
                            <p class="text-xs text-gray-400 mt-2">de {{ metricas.salas_totales|default(salas|length) }} totales</p>
                        </div>
                        <div class="mt-4 w-full bg-gray-100 dark:bg-gray-800 rounded-full h-2 overflow-hidden">
                            {# ✅ Usar porcentaje pre-calculado #}
                            <div class="bg-gradient-to-r from-emerald-400 to-emerald-600 h-full rounded-full transition-all duration-500" style="width: {{ metricas.porcentaje_barra_salas|default(0) }}%"></div>
                        </div>
                    </div>

                    {# 2. TIEMPO DE ESTUDIO HOY - ✅ CORREGIDO #}
                    <div class="bg-white dark:bg-darkCard p-6 rounded-[2rem] shadow-sm border border-gray-100 dark:border-darkBorder transition-all hover:shadow-lg hover:-translate-y-1 group">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-14 h-14 bg-gradient-to-br from-blue-400 to-blue-600 text-white rounded-2xl flex items-center justify-center text-2xl shadow-lg shadow-blue-500/30 group-hover:scale-110 transition-transform">
                                ⏱️
                            </div>
                            {% if metricas.tiempo_estudio_hoy > 0 %}
                                <span class="flex items-center gap-1 text-xs font-bold text-blue-600 bg-blue-50 dark:bg-blue-900/30 px-2 py-1 rounded-full">
                    {# ✅ Usar variable pre-formateada #}
                                    {{ metricas.tiempo_formateado|default('0m') }}
                </span>
                            {% endif %}
                        </div>
                        <div>
                            <p class="text-gray-400 dark:text-gray-500 text-xs font-bold uppercase tracking-wider mb-1">Tiempo de Estudio</p>
                            {# ✅ Usar variable pre-formateada #}
                            <p class="text-3xl font-black text-gray-800 dark:text-white" data-metric="tiempo">{{ metricas.tiempo_formateado|default('0s') }}</p>
                            <p class="text-xs text-gray-400 mt-2">Meta: {{ metricas.meta_formateada|default('5h 0m') }}</p>
                        </div>
                        <div class="mt-4 w-full bg-gray-100 dark:bg-gray-800 rounded-full h-2 overflow-hidden">
                            {# ✅ Usar porcentaje pre-calculado #}
                            <div class="bg-gradient-to-r from-blue-400 to-blue-600 h-full rounded-full transition-all duration-500" style="width: {{ metricas.porcentaje_barra_tiempo|default(0) }}%"></div>
                        </div>
                    </div>

                    {# 3. MENSAJES INTERCAMBIADOS #}
                    <div class="bg-white dark:bg-darkCard p-6 rounded-[2rem] shadow-sm border border-gray-100 dark:border-darkBorder transition-all hover:shadow-lg hover:-translate-y-1 group">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-14 h-14 bg-gradient-to-br from-purple-400 to-purple-600 text-white rounded-2xl flex items-center justify-center text-2xl shadow-lg shadow-purple-500/30 group-hover:scale-110 transition-transform">
                                💬
                            </div>
                            {% if metricas.porcentaje_cambio_mensajes > 0 %}
                                <span class="flex items-center gap-1 text-xs font-bold text-purple-600 bg-purple-50 dark:bg-purple-900/30 px-2 py-1 rounded-full">
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.293 9.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L11 7.414V15a1 1 0 11-2 0V7.414L6.707 9.707a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
                    +{{ metricas.porcentaje_cambio_mensajes }}%
                </span>
                            {% endif %}
                        </div>
                        <div>
                            <p class="text-gray-400 dark:text-gray-500 text-xs font-bold uppercase tracking-wider mb-1">Mensajes Hoy</p>
                            <p class="text-3xl font-black text-gray-800 dark:text-white" data-metric="mensajes">{{ metricas.mensajes_hoy|default(0) }}</p>
                            <p class="text-xs text-gray-400 mt-2">en {{ metricas.salas_participadas_hoy|default(0) }} salas</p>
                        </div>
                        <div class="mt-4 flex items-end gap-1 h-8">
                            {# Mini sparkline visual #}
                            <div class="flex-1 bg-purple-200 dark:bg-purple-900/40 rounded-sm" style="height: 40%"></div>
                            <div class="flex-1 bg-purple-300 dark:bg-purple-900/60 rounded-sm" style="height: 60%"></div>
                            <div class="flex-1 bg-purple-400 dark:bg-purple-900/80 rounded-sm" style="height: 80%"></div>
                            <div class="flex-1 bg-purple-500 dark:bg-purple-800 rounded-sm" style="height: 100%"></div>
                        </div>
                    </div>

                    {# 4. RACHA DE ESTUDIO (STREAK) #}
                    <div class="bg-gradient-to-br from-amber-50 to-orange-50 dark:from-amber-900/20 dark:to-orange-900/20 p-6 rounded-[2rem] shadow-sm border border-amber-200 dark:border-amber-800/30 transition-all hover:shadow-lg hover:-translate-y-1 group relative overflow-hidden">
                        <div class="absolute -right-4 -top-4 w-20 h-20 bg-amber-400/20 rounded-full blur-2xl group-hover:scale-150 transition-transform"></div>

                        <div class="relative">
                            <div class="flex items-center justify-between mb-4">
                                <div class="w-14 h-14 bg-gradient-to-br from-amber-400 to-orange-500 text-white rounded-2xl flex items-center justify-center text-2xl shadow-lg shadow-amber-500/30 group-hover:scale-110 transition-transform">
                                    🔥
                                </div>
                                {% if metricas.racha_dias > 0 %}
                                    <span class="text-xs font-bold text-amber-700 dark:text-amber-400 bg-amber-100 dark:bg-amber-900/40 px-2 py-1 rounded-full animate-pulse">
                        ¡Activo!
                    </span>
                                {% endif %}
                            </div>
                            <div>
                                <p class="text-amber-700 dark:text-amber-400 text-xs font-bold uppercase tracking-wider mb-1">Racha Actual</p>
                                <p class="text-3xl font-black text-amber-900 dark:text-amber-200">{{ metricas.racha_dias|default(0) }} <span class="text-lg">días</span></p>
                                <p class="text-xs text-amber-600 dark:text-amber-500 mt-2">Récord: {{ metricas.record_racha|default(0) }} días</p>
                            </div>
                            <div class="mt-4 flex gap-1">
                                {% for i in 1..7 %}
                                    <div class="flex-1 h-2 rounded-full {{ i <= metricas.racha_dias|default(0) ? 'bg-amber-500' : 'bg-amber-200 dark:bg-amber-800/40' }}"></div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>

                {# 4. LISTADO DE SALAS #}
                <div class="pt-4">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-2xl font-black text-gray-800 dark:text-white">Tus salas activas</h2>
                    </div>

                    {# Contenedor de grilla para JS #}
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="salas-grid">
                        {% for sala in salas|default([]) %}
                            {# Agregamos la clase 'sala-card' y un data-attribute con el nombre para filtrar #}
                            <div class="sala-card bg-white dark:bg-darkCard p-6 rounded-[2.5rem] border border-gray-100 dark:border-darkBorder shadow-sm hover:shadow-xl transition-all group" data-title="{{ sala.nombre|lower }}">
                                <div class="flex justify-between items-start mb-4">
                                    <span class="px-3 py-1 rounded-lg text-xs font-bold bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400">
                                        {{ sala.categoria|default('General') }}
                                    </span>
                                    {% if app.user == sala.creador %}
                                        <span class="text-amber-500 text-xs font-bold">Propietario</span>
                                    {% endif %}
                                </div>
                                <h3 class="text-xl font-bold text-gray-800 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">{{ sala.nombre }}</h3>
                                <p class="text-sm text-gray-400 dark:text-gray-500 mt-2 line-clamp-2">{{ sala.descripcion|default('Sin descripción adicional.') }}</p>
                                <a href="{{ path('app_sala_show', {id: sala.id}) }}" class="mt-6 block w-full text-center bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white py-3 rounded-2xl font-bold text-sm hover:bg-emerald-800 hover:text-white dark:hover:bg-emerald-700 transition-all">
                                    Entrar a estudiar
                                </a>
                            </div>
                        {% else %}
                            <div class="col-span-full py-12 text-center bg-white dark:bg-darkCard rounded-[2.5rem] border-2 border-dashed border-gray-200 dark:border-darkBorder" id="no-results-msg">
                                <p class="text-gray-400 font-medium">No se encontraron salas disponibles.</p>
                            </div>
                        {% endfor %}
                    </div>

                    {# Controles de Paginación #}
                    <div id="pagination-controls" class="flex justify-between items-center mt-8 px-2 hidden">
                        <button id="btn-prev" class="px-5 py-2.5 bg-white dark:bg-darkCard border border-gray-200 dark:border-darkBorder rounded-xl text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 disabled:opacity-40 font-bold text-sm transition-all shadow-sm">
                            &larr; Anterior
                        </button>
                        <span id="page-info" class="text-sm font-bold text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-800 px-4 py-2 rounded-xl">Página 1 de 1</span>
                        <button id="btn-next" class="px-5 py-2.5 bg-white dark:bg-darkCard border border-gray-200 dark:border-darkBorder rounded-xl text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 disabled:opacity-40 font-bold text-sm transition-all shadow-sm">
                            Siguiente &rarr;
                        </button>
                    </div>
                </div>
            </div>
        </div>

        {# =============================================================================
           MODAL PARA NUEVA SALA (SPA STYLE - DARK THEME)
           ============================================================================= #}
        <div id="modal-nueva-sala" class="hidden fixed inset-0 z-[100] overflow-y-auto flex items-center justify-center p-4 sm:p-6">
            {# Fondo oscuro con desenfoque #}
            <div class="fixed inset-0 bg-gray-900/70 backdrop-blur-sm transition-opacity" onclick="window.closeNuevaSalaModal()"></div>

            {# Contenedor principal del modal #}
            <div class="relative bg-[#1a1b26] w-full max-w-xl rounded-[2rem] shadow-2xl overflow-hidden transform transition-all animate-fade-in-up border border-gray-800">
                <div class="p-8 md:p-10">

                    {# Cabecera #}
                    <h2 class="text-3xl font-black text-white mb-1">Crear nueva sala</h2>
                    <p class="text-indigo-400/80 mb-8 text-sm">Define tu espacio y empieza a colaborar en tiempo real.</p>

                    <form id="form-sala-ajax" action="{{ path('app_sala_new_ajax') }}" method="POST" novalidate class="space-y-6">
                        {{ form_widget(form._token) }}
                        {# Input: Nombre de la Sala #}
                        <div>
                            <label class="block text-sm font-bold text-indigo-300 mb-2">Nombre de la Sala</label>
                            {{ form_widget(form.nombre, {
                                'attr': {
                                    'class': 'w-full rounded-2xl border border-transparent bg-[#13141f] text-white placeholder-gray-600 py-4 px-5 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all',
                                    'placeholder': 'Ej: Matemáticas Avanzadas'
                                }
                            }) }}
                        </div>

                        {# Input: Categoría #}
                        <div>
                            <label class="block text-sm font-bold text-indigo-300 mb-2">Categoría</label>
                            {{ form_widget(form.categoria, {
                                'attr': {
                                    'class': 'w-full rounded-2xl border border-transparent bg-[#13141f] text-white py-4 px-5 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all'
                                }
                            }) }}
                        </div>

                        {# Input: Descripción #}
                        <div>
                            <label class="block text-sm font-bold text-indigo-300 mb-2">Descripción</label>
                            {{ form_widget(form.descripcion, {
                                'attr': {
                                    'class': 'w-full rounded-2xl border border-transparent bg-[#13141f] text-white placeholder-gray-600 py-4 px-5 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all resize-none',
                                    'rows': '3',
                                    'placeholder': '¿De qué trata esta sala?'
                                }
                            }) }}
                        </div>

                        {# Botones de Acción #}
                        <div class="flex items-center justify-end gap-6 pt-4">
                            <button type="button" onclick="window.closeNuevaSalaModal()" class="text-indigo-300 font-bold hover:text-white transition-colors">
                                Cancelar
                            </button>
                            <button type="submit" id="btn-submit-sala" class="bg-[#059669] hover:bg-emerald-600 text-white font-bold py-3 px-8 rounded-xl shadow-lg transition-all transform hover:scale-105 flex items-center gap-2">
                                <span>Crear sala</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        {# =============================================================================
           SCRIPTS DE FUNCIONALIDAD SPA Y TIEMPO REAL
           ============================================================================= #}
        <script>
            // Nombres únicos para evitar conflictos con base.html.twig
            window.openNuevaSalaModal = function() {
                const modal = document.getElementById('modal-nueva-sala');
                if (modal) {
                    modal.classList.remove('hidden');
                    document.body.style.overflow = 'hidden';
                } else {
                    console.error("No se encontró el modal de nueva sala");
                }
            };

            window.closeNuevaSalaModal = function() {
                const modal = document.getElementById('modal-nueva-sala');
                if (modal) {
                    modal.classList.add('hidden');
                    document.body.style.overflow = '';
                }
            };

            document.addEventListener('DOMContentLoaded', () => {
                const form = document.getElementById('form-sala-ajax');
                if (form) {
                    form.addEventListener('submit', async function(e) {
                        e.preventDefault();

                        const btn = document.getElementById('btn-submit-sala');

                        // =====================================================
                        // VALIDACIÓN PERSONALIZADA CON MENSAJES AMIGABLES
                        // =====================================================

                        // Obtener valor del campo NOMBRE
                        const nombreInput = this.querySelector('#sala_nombre') || this.querySelector('[name="sala[nombre]"]');
                        const nombre = nombreInput ? nombreInput.value.trim() : '';

                        // Validar que el nombre NO esté vacío
                        if (!nombre || nombre.length === 0) {
                            Swal.fire({
                                icon: 'info',
                                title: 'Nombre requerido',
                                text: 'Por favor escribe un nombre para tu sala de estudio',
                                toast: true,
                                position: 'top-end',
                                showConfirmButton: false,
                                timer: 3000,
                                timerProgressBar: true
                            });

                            if (nombreInput) {
                                nombreInput.focus();
                                nombreInput.style.borderColor = '#818cf8'; // Azul suave en vez de rojo
                                nombreInput.style.boxShadow = '0 0 0 3px rgba(129, 140, 248, 0.3)';

                                setTimeout(() => {
                                    nombreInput.style.borderColor = '';
                                    nombreInput.style.boxShadow = '';
                                }, 3000);
                            }

                            return;
                        }

                        // Validar longitud mínima
                        if (nombre.length < 3) {
                            Swal.fire({
                                icon: 'info',
                                title: 'Nombre muy corto',
                                text: 'Usa al menos 3 caracteres para el nombre',
                                toast: true,
                                position: 'top-end',
                                showConfirmButton: false,
                                timer: 3000,
                                timerProgressBar: true
                            });

                            if (nombreInput) {
                                nombreInput.focus();
                            }

                            return;
                        }

                        // =====================================================
                        // ENVIAR AL SERVIDOR
                        // =====================================================

                        btn.disabled = true;
                        btn.innerHTML = '<svg class="animate-spin h-5 w-5 mr-2" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>Creando...';

                        try {
                            const response = await fetch(this.action, {
                                method: 'POST',
                                body: new FormData(this),
                                headers: { 'X-Requested-With': 'XMLHttpRequest' }
                            });

                            // Verificar si respuesta es JSON válido
                            const contentType = response.headers.get('content-type');

                            if (!contentType || !contentType.includes('application/json')) {
                                // Error del servidor (devolvió HTML)
                                console.error('Error HTML recibido:', await response.text());

                                throw new Error('server_error');
                            }

                            const data = await response.json();
                            console.log('Respuesta:', data);

                            if (data.success) {
                                // =====================================================
                                // ÉXITO - Redirigir con animación
                                // =====================================================

                                Swal.fire({
                                    icon: 'success',
                                    title: '¡Sala creada!',
                                    text: '¡Bienvenido a "' + (data.sala_nombre || nombre) + '"!',
                                    toast: true,
                                    position: 'top-end',
                                    showConfirmButton: false,
                                    timer: 2000,
                                    timerProgressBar: true
                                }).then(() => {
                                    if (data.redirect_url) {
                                        window.location.href = data.redirect_url;
                                    } else {
                                        window.location.reload();
                                    }
                                });

                            } else {
                                // =====================================================
                                // ERROR DEL SERVIDOR - Mensajes AMIGABLES
                                // =====================================================

                                let mensajeAmigable = '';

                                // Detectar tipo de error y personalizar mensaje
                                if (data.duplicate || data.message?.toLowerCase().includes('duplicate')) {
                                    mensajeAmigable = 'Este nombre ya existe. Prueba con otro nombre para crear una nueva sala';
                                } else if (data.message?.toLowerCase().includes('unique')) {
                                    mensajeAmigable = 'Ya tienes una sala con ese nombre. Usa un nombre diferente';
                                } else if (data.errors && data.errors.length > 0) {
                                    mensajeAmigable = data.errors[0]; // Primer error de validación
                                } else {
                                    mensajeAmigable = 'No se pudo crear la sala. Intenta con otro nombre';
                                }

                                // Mostrar toast AMIGABLE (no asustar al usuario)
                                Swal.fire({
                                    icon: 'warning', // Warning en vez de error (menos agresivo)
                                    title: 'Oops...',
                                    text: mensajeAmigable,
                                    toast: true,
                                    position: 'top-end',
                                    showConfirmButton: false,
                                    timer: 3500,
                                    timerProgressBar: true
                                });

                                // Opcional: Limpiar campo nombre para que escriba uno nuevo
                                if (nombreInput) {
                                    nombreInput.value = '';
                                    nombreInput.focus();
                                    nombreInput.style.borderColor = '#fbbf24'; // Amarillo suave
                                    nombreInput.style.boxShadow = '0 0 0 3px rgba(251, 191, 36, 0.3)';

                                    setTimeout(() => {
                                        nombreInput.style.borderColor = '';
                                        nombreInput.style.boxShadow = '';
                                    }, 3500);
                                }
                            }

                        } catch (error) {
                            console.error('Error:', error);

                            // =====================================================
                            // ERROR DE CONEXIÓN / RED - Mensaje simple
                            // =====================================================

                            Swal.fire({
                                icon: 'info', // Info en vez de error
                                title: 'Sin conexión',
                                text: 'Revisa tu conexión a internet e intenta nuevamente',
                                toast: true,
                                position: 'top-end',
                                showConfirmButton: false,
                                timer: 4000,
                                timerProgressBar: true
                            });

                        } finally {
                            // Restaurar botón SIEMPRE
                            btn.disabled = false;
                            btn.innerHTML = '<span>Crear sala</span>';
                        }
                    });
                }
            });

                document.addEventListener('DOMContentLoaded', () => {
                        const searchInput = document.getElementById('live-search');
                        const cards = Array.from(document.querySelectorAll('.sala-card'));
                        const btnPrev = document.getElementById('btn-prev');
                        const btnNext = document.getElementById('btn-next');
                        const pageInfo = document.getElementById('page-info');
                        const paginationControls = document.getElementById('pagination-controls');
                        const totalSalasCount = document.getElementById('total-salas-count');

                        let currentPage = 1;

                        function renderSalas() {
                            if (!searchInput) return;

                            const query = searchInput.value.toLowerCase().trim();

                            // 1. Filtrar las tarjetas por búsqueda
                            const filteredCards = cards.filter(card => card.dataset.title.includes(query));

                            // Actualizamos la tarjeta de estadística "Salas Visibles" en vivo
                            if(totalSalasCount) totalSalasCount.textContent = filteredCards.length;

                            // 2. Lógica de Paginación (3 en móviles, 6 en PC)
                            const isMobile = window.innerWidth < 768;
                            const itemsPerPage = isMobile ? 3 : 6;
                            const totalPages = Math.ceil(filteredCards.length / itemsPerPage) || 1;

                            if (currentPage > totalPages) currentPage = totalPages;

                            const start = (currentPage - 1) * itemsPerPage;
                            const end = start + itemsPerPage;

                            // 3. Ocultar todas y mostrar solo las de esta página
                            cards.forEach(card => card.style.display = 'none');
                            filteredCards.slice(start, end).forEach(card => card.style.display = 'block');

                            // 4. Actualizar botones e información
                            if (filteredCards.length > 0) {
                                paginationControls.classList.remove('hidden');
                                pageInfo.textContent = `Página ${currentPage} de ${totalPages}`;
                                btnPrev.disabled = currentPage === 1;
                                btnNext.disabled = currentPage === totalPages;
                            } else {
                                paginationControls.classList.add('hidden'); // Ocultar paginación si no hay resultados
                            }
                        }

                        if (searchInput && cards.length > 0) {
                            // Evento al escribir (Búsqueda instantánea)
                            searchInput.addEventListener('input', () => {
                                currentPage = 1; // Regresar a pag 1 al buscar
                                renderSalas();
                            });

                            // Eventos de botones
                            btnPrev.addEventListener('click', () => { if (currentPage > 1) { currentPage--; renderSalas(); } });
                            btnNext.addEventListener('click', () => { if (currentPage < 99) { currentPage++; renderSalas(); } });

                            // Escuchar si se cambia el tamaño de la ventana (para cambiar de 6 a 3 automático)
                            window.addEventListener('resize', renderSalas);

                            // Renderizado inicial
                            renderSalas();
                        }
                    });
                </script>

